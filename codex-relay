    else
        ui_warn "$(L 'auth.json 已更新，但后台服务刷新失败；如仍使用旧认证，请执行: codex app-server daemon stop' 'auth.json updated but daemon refresh failed; if old auth persists, run: codex app-server daemon stop')"
    fi

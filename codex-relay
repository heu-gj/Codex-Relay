refresh_official_quota_cache() {
    local source cache
    source="$(official_auth_source || true)"
    [[ -n "$source" ]] || return 1
    cache="$CACHE_DIR/official-quota.json"

    python3 - "$source" "$cache" <<'PY'
import json
import sys
from pathlib import Path
from urllib.request import Request, build_opener, ProxyHandler
from urllib.error import HTTPError, URLError

auth_path = Path(sys.argv[1])
cache_path = Path(sys.argv[2])

try:
    auth = json.loads(auth_path.read_text(encoding="utf-8"))
except Exception:
    raise SystemExit(1)

tokens = auth.get("tokens") or {}
access_token = tokens.get("access_token") or auth.get("access_token")
account_id = tokens.get("account_id") or auth.get("account_id")
if not access_token:
    raise SystemExit(1)

headers = {
    "Authorization": f"Bearer {access_token}",
    "Accept": "application/json",
    "User-Agent": "Codex-Relay/usage",
}
if account_id:
    headers["ChatGPT-Account-Id"] = account_id

req = Request("https://chatgpt.com/backend-api/codex/usage", headers=headers)
opener = build_opener(ProxyHandler({}))

try:
    with opener.open(req, timeout=5) as resp:
        data = json.load(resp)
except (HTTPError, URLError, TimeoutError, ValueError):
    raise SystemExit(1)

rate = data.get("rate_limit") or {}
windows = []

def label_for(seconds, fallback):
    try:
        seconds = int(seconds)
    except Exception:
        return fallback
    if 16200 <= seconds <= 19800:
        return "5h"
    if 576000 <= seconds <= 691200:
        return "7d"
    if 82800 <= seconds <= 90000:
        return "1d"
    if seconds > 0 and seconds % 3600 == 0:
        return f"{seconds // 3600}h"
    return fallback

for key, fallback in (("primary_window", "primary"), ("secondary_window", "secondary")):
    w = rate.get(key)
    if not isinstance(w, dict):
        continue
    used = w.get("used_percent")
    try:
        remaining = max(0, min(100, round(100 - float(used))))
    except Exception:
        remaining = None
    windows.append({
        "label": label_for(w.get("limit_window_seconds"), fallback),
        "remaining_percent": remaining,
        "reset_at": w.get("reset_at"),
    })

credits = data.get("credits") or {}
reset_credits = data.get("rate_limit_reset_credits") or {}
normalized = {
    "plan": data.get("plan_type"),
    "allowed": rate.get("allowed"),
    "limit_reached": rate.get("limit_reached"),
    "windows": windows,
    "credits_balance": credits.get("balance"),
    "credits_unlimited": credits.get("unlimited"),
    "reset_credits": reset_credits.get("available_count"),
}
cache_path.write_text(json.dumps(normalized, ensure_ascii=False) + "\n", encoding="utf-8")
PY
}


# -----------------------------
# 每用户 / 每 Profile API Key
# -----------------------------
key_file_for_profile() {
    printf '%s/%s.key' "$SECRETS_DIR" "$1"
}

relay_key_exists() {
    [[ -s "$(key_file_for_profile "$1")" ]]
}

save_relay_key() {
    local name="$1" key="$2" file tmp
    [[ -n "$key" ]] || die "$(L 'API Key 不能为空' 'API key cannot be empty')"
    file="$(key_file_for_profile "$name")"
    tmp="$(mktemp "$SECRETS_DIR/.key.XXXXXX")"
    chmod 600 "$tmp"
    printf '%s' "$key" > "$tmp"
    mv "$tmp" "$file"
    chmod 600 "$file" 2>/dev/null || true
}

read_relay_key() {
    local file key=""
    file="$(key_file_for_profile "$1")"
    [[ -s "$file" ]] || return 1
    IFS= read -r key < "$file" || true
    printf '%s' "$key"
}

prompt_relay_key() {
    local name="$1" key
    printf '%s' "$(L "请输入 $name 的 API Key（输入不会显示）: " "Enter API key for $name (hidden): ")"
    IFS= read -r -s key
    printf '\n'
    [[ -n "$key" ]] || die "$(L 'API Key 不能为空' 'API key cannot be empty')"
    save_relay_key "$name" "$key"
    ui_ok "$(L "已保存 $name 的 API Key（仅当前用户）" "Saved API key for $name (current user only)")"
}

ensure_relay_key() {
    relay_key_exists "$1" || prompt_relay_key "$1"
}

cmd_key() {
    local action="${1:-list}" name="${2:-}"
    case "$action" in
        set)
            [[ -n "$name" ]] || die "$(L '用法: cr key set PROFILE' 'Usage: cr key set PROFILE')"
            load_profile "$name"
            [[ "$P_AUTH" == "relay" ]] || die "$(L '这个 profile 不是 relay 托管 Key 模式' 'This profile does not use relay-managed keys')"
            prompt_relay_key "$name"
            if [[ "$(current_profile)" == "$name" ]]; then
                apply_auth_for_profile "$name"
                ui_warn "$(L '当前正在使用这个中转站；API Key 已更新，将自动停止当前用户的 Codex 服务/进程，使新认证立即生效。' 'This provider is active; the API key changed, so current-user Codex services/processes will be stopped to apply the new auth immediately.')"
                cmd_stop || true
            fi
            ;;
        remove|rm|delete)
            [[ -n "$name" ]] || die "$(L '用法: cr key remove PROFILE' 'Usage: cr key remove PROFILE')"
            rm -f "$(key_file_for_profile "$name")"
            if [[ "$(current_profile)" == "$name" && "$(auth_json_mode || true)" == "apikey" ]]; then
                backup_auth_json
                rm -f "$AUTH_FILE"
                AUTH_CHANGED=1
                : > "$AUTH_RELOAD_FLAG"
                ui_warn "$(L '当前正在使用这个中转站；API Key 已删除，将自动停止当前用户的 Codex 服务/进程。' 'This provider is active; its API key was removed, so current-user Codex services/processes will be stopped.')"
                cmd_stop || true
            fi
            ui_ok "$(L "已删除 $name 的本地 API Key" "Removed local API key for $name")"
            ;;
        list|status|"")
            ui_header "$(L 'API KEY 管理' 'API KEY MANAGEMENT')"
            ui_kv "$(L '密钥目录' 'secret dir')" "$SECRETS_DIR"
            printf '\n'
            local p state
            while read -r p; do
                [[ -n "$p" ]] || continue
                load_profile "$p"
                [[ "$P_AUTH" == "relay" ]] || continue
                if relay_key_exists "$p"; then state="$(L '已设置 ✓' 'SET ✓')"; else state="$(L '未设置' 'NOT SET')"; fi
                printf '  %-12s %s\n' "$p" "$state"
            done < <(profile_names)
            printf '\n'
            ui_info "$(L 'Key 不写入 config.toml；激活中转站时会按 Codex 官方格式写入 ~/.codex/auth.json' 'Keys are not written to config.toml; activating a relay writes native Codex auth.json')"
            ;;
        *)
            die "$(L '用法: cr key [list|set PROFILE|remove PROFILE]' 'Usage: cr key [list|set PROFILE|remove PROFILE]')"
            ;;
    esac
}


cmd_key_menu() {
    while true; do
        clear || true
        ui_header "$(L 'API KEY 管理' 'API KEY MANAGEMENT')"
        printf '\n'
        local p state
        for p in nova baibai; do
            if relay_key_exists "$p"; then state="$(L '已设置 ✓' 'SET ✓')"; else state="$(L '未设置' 'NOT SET')"; fi
            ui_kv "$p" "$state"
        done

        printf '\n'
        ui_menu_item "1" "$(L '设置 / 更新 Nova Key' 'Set / update Nova key')" ""
        ui_menu_item "2" "$(L '设置 / 更新 baibai Key' 'Set / update baibai key')" ""
        ui_menu_item "3" "$(L '删除 Nova Key' 'Remove Nova key')" ""
        ui_menu_item "4" "$(L '删除 baibai Key' 'Remove baibai key')" ""
        ui_menu_item "0" "$(L '返回' 'Back')" ""
        printf '\n%s›%s %s%s%s  ' "$UI_PINK" "$UI_RESET" "$UI_BOLD" "$(L '请选择操作' 'Choose an action')" "$UI_RESET"
        read -r choice
        case "$choice" in

cmd_health() {
    ui_header "HISTORY HEALTH"
    need python3

    python3 - "$CODEX_DIR" <<'PY'
from pathlib import Path
import sqlite3,json,sys,collections

home=Path(sys.argv[1])

db_ids=set()
providers=collections.Counter()
db=home/"state_5.sqlite"
if db.exists():
    c=sqlite3.connect(db)
    for sid,p in c.execute("SELECT id,model_provider FROM threads"):
        db_ids.add(sid)
        providers[p]+=1
    c.close()

index_ids=set()
idx=home/"session_index.jsonl"
if idx.exists():
    for line in idx.open("r",encoding="utf-8",errors="replace"):
        try:
            obj=json.loads(line)
            sid=obj.get("id")
            if sid:
                index_ids.add(sid)
        except Exception:
            pass

rollout_files=0
session_ids=set()
for dirname in ("sessions", "archived_sessions"):
    root=home/dirname
    if not root.exists():
        continue
    for path in root.rglob("rollout-*.jsonl"):
        rollout_files += 1
        try:
            with path.open("r",encoding="utf-8",errors="replace") as f:
                for line in f:
                    try:
                        obj=json.loads(line)
                    except Exception:
                        continue
                    if obj.get("type")=="session_meta":
                        sid=obj.get("payload",{}).get("id")
                        if sid:
                            session_ids.add(sid)
                        break
        except Exception:
            pass

print("=== Codex history health ===")
print("rollout files       :",rollout_files)
print("unique session IDs  :",len(session_ids))
print("SQLite threads      :",len(db_ids))
print("session index IDs   :",len(index_ids))
print("session - SQLite    :",len(session_ids-db_ids))
print("SQLite - sessions   :",len(db_ids-session_ids))
print("SQLite - index      :",len(db_ids-index_ids))
print("index - SQLite      :",len(index_ids-db_ids))

if providers:
    print("\n=== Provider distribution ===")
    for p,n in providers.most_common():
        print(f"{p or '<empty>':20} {n}")

print()
if session_ids == db_ids == index_ids:
    print("STATUS: HEALTHY")
elif session_ids == db_ids and db_ids != index_ids:
    print("STATUS: INDEX OUT OF SYNC")
    print("可以运行: cr reindex")
elif session_ids-db_ids:
    print("STATUS: ROLLOUT EXISTS BUT SQLITE MISSING THREADS")
    print("仍可尝试: cr resume THREAD_ID PROFILE")
else:
    print("STATUS: CHECK REQUIRED")
PY
}


from pathlib import Path
from datetime import datetime, timezone
import json
import sqlite3
import sys
import time

home = Path(sys.argv[1]).expanduser().resolve()
db = home / "state_5.sqlite"
idx = home / "session_index.jsonl"


def jtext(v):
    if v is None:
        return ""
    if isinstance(v, str):
        return v
    return json.dumps(v, ensure_ascii=False, separators=(",", ":"))


def parse_ts(v):
    if not v:
        return None
    if isinstance(v, (int, float)):
        x = float(v)
        if x > 10_000_000_000:
            x /= 1000.0
        return x
    if isinstance(v, str):
        z = v.strip()
        if not z:
            return None
        try:
            x = float(z)
            if x > 10_000_000_000:
                x /= 1000.0
            return x
        except Exception:
            pass
        try:
            return datetime.fromisoformat(z.replace("Z", "+00:00")).timestamp()
        except Exception:
            return None
    return None


def first_text_from_content(content):
    if isinstance(content, str):
        return content
    if not isinstance(content, list):
        return ""
    parts = []
    for item in content:
        if isinstance(item, str):
            parts.append(item)
            continue
        if not isinstance(item, dict):
            continue
        for k in ("text", "input_text", "output_text"):
            val = item.get(k)
            if isinstance(val, str) and val.strip():
                parts.append(val)
                break
    return " ".join(parts)


def scan_rollout(path: Path, archived: bool):
    meta = None
    first_user = ""
    latest_ts = None
    try:
        with path.open("r", encoding="utf-8", errors="replace") as f:
            for line in f:
                try:
                    obj = json.loads(line)
                except Exception:
                    continue

                payload = obj.get("payload")
                for candidate in (
                    obj.get("timestamp"),
                    payload.get("timestamp") if isinstance(payload, dict) else None,
                ):
                    ts = parse_ts(candidate)
                    if ts is not None and (latest_ts is None or ts > latest_ts):
                        latest_ts = ts

                typ = obj.get("type")
                if typ == "session_meta" and isinstance(payload, dict) and meta is None:
                    meta = payload

                if not first_user and typ == "response_item" and isinstance(payload, dict):
                    if payload.get("role") == "user":
                        text = first_text_from_content(payload.get("content"))
                        if text.strip():
                            first_user = " ".join(text.split())

                if not first_user and typ == "event_msg" and isinstance(payload, dict):
                    if payload.get("role") == "user" or payload.get("type") in ("user_message", "user_msg"):
                        text = payload.get("message") or payload.get("text") or first_text_from_content(payload.get("content"))
                        if isinstance(text, str) and text.strip():
                            first_user = " ".join(text.split())
    except Exception as exc:
        return None, f"{path}: {exc}"

    if not meta or not meta.get("id"):
        return None, None

    stat = path.stat()
    created = parse_ts(meta.get("timestamp")) or stat.st_mtime
    updated = latest_ts or stat.st_mtime or created
    if updated < created:
        updated = created

    sid = str(meta.get("id"))
    title = first_user[:300] if first_user else f"Restored session {sid[:13]}"

    return {
        "id": sid,
        "rollout_path": str(path.resolve()),
        "created_at": int(created),
        "updated_at": int(updated),
        "source": jtext(meta.get("source") or "cli"),
        "model_provider": str(meta.get("model_provider") or ""),
        "cwd": str(meta.get("cwd") or str(home)),
        "title": title,
        "sandbox_policy": jtext(meta.get("sandbox_policy") or ""),
        "approval_mode": jtext(meta.get("approval_mode") or ""),
        "tokens_used": 0,
        "has_user_event": 1 if first_user else 0,
        "archived": 1 if archived else 0,
        "archived_at": int(updated) if archived else None,
        "cli_version": str(meta.get("cli_version") or ""),
        "first_user_message": first_user[:4000],
        "memory_mode": str(meta.get("memory_mode") or "enabled"),
        "model": str(meta.get("model") or ""),
        "reasoning_effort": str(meta.get("reasoning_effort") or meta.get("model_reasoning_effort") or ""),
        "created_at_ms": int(created * 1000),
        "updated_at_ms": int(updated * 1000),
        "thread_source": str(meta.get("thread_source") or ("user" if first_user else "")),
        "preview": first_user[:1000],
        "recency_at": int(updated),
        "recency_at_ms": int(updated * 1000),
        "history_mode": str(meta.get("history_mode") or "legacy"),
        "name": None,
        "is_pinned": 0,
        "originator": jtext(meta.get("originator")) or None,
    }, None


records = {}
errors = []
rollout_files = 0

for dirname, archived in (("sessions", False), ("archived_sessions", True)):
    root = home / dirname
    if not root.exists():
        continue
    for path in root.rglob("rollout-*.jsonl"):
        rollout_files += 1
        rec, err = scan_rollout(path, archived)
        if err:
            errors.append(err)
        if not rec:
            continue
        sid = rec["id"]
        old = records.get(sid)
        rank = (0 if rec["archived"] else 1, rec["updated_at"])
        old_rank = (-1, -1) if old is None else (0 if old["archived"] else 1, old["updated_at"])
        if old is None or rank > old_rank:
            records[sid] = rec

conn = sqlite3.connect(db)
conn.row_factory = sqlite3.Row

integrity = conn.execute("PRAGMA integrity_check").fetchone()[0]
if integrity != "ok":
    conn.close()
    print("ABORT: SQLite integrity_check != ok")
    print("Result:", integrity)
    print("备份已经完成，但没有写入数据库。")
    raise SystemExit(2)

schema_rows = conn.execute("PRAGMA table_info(threads)").fetchall()
if not schema_rows:
    conn.close()
    raise SystemExit("threads 表不存在")

schema = {
    r[1]: {
        "type": (r[2] or "").upper(),
        "notnull": bool(r[3]),
        "default": r[4],
        "pk": bool(r[5]),
    }
    for r in schema_rows
}
columns = set(schema)
existing = {r["id"]: r for r in conn.execute("SELECT * FROM threads")}

inserted = 0
path_fixed = 0
provider_fixed = 0
metadata_fixed = 0
archived_fixed = 0


def path_exists(value):
    if not value:
        return False
    try:
        p = Path(str(value)).expanduser()
        if not p.is_absolute():
            p = home / p
        return p.exists()
    except Exception:
        return False


def fallback_for_required(info):
    t = info["type"]
    if any(x in t for x in ("INT", "REAL", "NUM", "BOOL")):
        return 0
    return ""

with conn:
    for sid, rec in records.items():
        row = existing.get(sid)
        if row is None:
            vals = {col: value for col, value in rec.items() if col in columns}
            for col, info in schema.items():
                if col in vals or info["pk"]:
                    continue
                if info["notnull"] and info["default"] is None:
                    vals[col] = fallback_for_required(info)

            names = list(vals)
            placeholders = ",".join("?" for _ in names)
            sql = f"INSERT INTO threads ({','.join(names)}) VALUES ({placeholders})"
            conn.execute(sql, [vals[n] for n in names])
            inserted += 1
            continue

        updates = {}

        if "rollout_path" in columns and not path_exists(row["rollout_path"]):
            updates["rollout_path"] = rec["rollout_path"]
            path_fixed += 1
            if "archived" in columns and int(row["archived"] or 0) != int(rec["archived"]):
                updates["archived"] = rec["archived"]
                archived_fixed += 1
                if "archived_at" in columns:
                    updates["archived_at"] = rec["archived_at"]

        for col in (
            "model_provider", "cwd", "source", "cli_version", "model",
            "reasoning_effort", "first_user_message", "title", "preview",
            "thread_source", "originator"
        ):
            if col not in columns:
                continue
            current = row[col]
            candidate = rec.get(col)
            if (current is None or str(current).strip() == "") and candidate not in (None, ""):
                updates[col] = candidate
                if col == "model_provider":
                    provider_fixed += 1
                else:
                    metadata_fixed += 1

        for col in ("created_at", "updated_at", "created_at_ms", "updated_at_ms", "recency_at", "recency_at_ms"):
            if col not in columns:
                continue
            current = row[col]
            candidate = rec.get(col)
            if (current is None or current == 0) and candidate not in (None, 0):
                updates[col] = candidate
                metadata_fixed += 1

        if updates:
            set_sql = ",".join(f"{k}=?" for k in updates)
            conn.execute(f"UPDATE threads SET {set_sql} WHERE id=?", [*updates.values(), sid])

integrity_after = conn.execute("PRAGMA integrity_check").fetchone()[0]
if integrity_after != "ok":
    conn.close()
    raise SystemExit(f"修复后 SQLite integrity_check 失败: {integrity_after}")

name_cols = [c for c in ("name", "title", "first_user_message", "preview") if c in columns]
if name_cols:
    title_expr = "COALESCE(" + ",".join(f"NULLIF({c},'')" for c in name_cols) + ",id)"
else:
    title_expr = "id"

updated_expr = "updated_at_ms" if "updated_at_ms" in columns else "updated_at*1000"
rows = conn.execute(
    f"SELECT id,{title_expr} AS display_name,{updated_expr} AS updated_ms "
    f"FROM threads ORDER BY {updated_expr}"
).fetchall()

index_tmp = home / "session_index.jsonl.repair"
with index_tmp.open("w", encoding="utf-8") as f:
    for r in rows:
        name = str(r["display_name"] or r["id"]).replace("\n", " ").strip()
        if len(name) > 300:
            name = name[:297] + "..."
        ms = r["updated_ms"] or int(time.time() * 1000)
        if ms < 10_000_000_000:
            ms *= 1000
        dt = datetime.fromtimestamp(ms / 1000.0, timezone.utc).isoformat().replace("+00:00", "Z")
        f.write(json.dumps({
            "id": r["id"],
            "thread_name": name,
            "updated_at": dt,
        }, ensure_ascii=False) + "\n")

index_tmp.replace(idx)
index_count = len(rows)
conn.close()

print("rollout files scanned :", rollout_files)
print("unique session IDs    :", len(records))
print("SQLite rows inserted  :", inserted)
print("rollout paths fixed   :", path_fixed)
print("providers filled      :", provider_fixed)
print("metadata fields filled:", metadata_fixed)
print("archive flags fixed   :", archived_fixed)
print("index entries rebuilt :", index_count)
print("SQLite integrity      :", integrity_after)
if errors:
    print("rollout read warnings :", len(errors))
    for e in errors[:10]:
        print("  WARN:", e)
REPAIRPY
    then
        ui_fail "$(L 'SQLite / rollout 修复阶段失败，已停止后续恢复流程。可从刚创建的历史备份恢复。' 'SQLite / rollout repair failed; the recovery workflow has stopped. The newly created history backup is available for rollback.')"
        return 1
    fi

    echo
    echo "[3/4] 重新检查聊天库一致性..."
    cmd_health

    echo
    echo "[4/4] 完成"
    echo "建议现在运行:"
    echo "  cr resume-all"
    echo
    echo "如果某条聊天仍未显示，可用:"
    echo "  cr history 200"
    echo "  cr resume THREAD_ID"
}


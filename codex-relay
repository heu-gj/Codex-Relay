#!/usr/bin/env bash
set -euo pipefail

CODEX_DIR="${CODEX_HOME:-$HOME/.codex}"
RELAY_DIR="${CODEX_RELAY_HOME:-$HOME/.codex-relay}"

# Codex 自己的数据只放在 ~/.codex；codex-relay 的状态单独放在 ~/.codex-relay。
CONFIG="$CODEX_DIR/config.toml"
AUTH_FILE="$CODEX_DIR/auth.json"
CURRENT="$RELAY_DIR/current"
REGISTRY="$RELAY_DIR/relays.tsv"
OFFICIAL_MODEL_FILE="$RELAY_DIR/official-model"
LANGUAGE_FILE="$RELAY_DIR/language"
SECRETS_DIR="$RELAY_DIR/secrets"
AUTH_DIR="$RELAY_DIR/auth"
OFFICIAL_AUTH_FILE="$AUTH_DIR/official.json"
AUTH_RELOAD_FLAG="$AUTH_DIR/reload-needed"
CACHE_DIR="$RELAY_DIR/cache"
OVERRIDES_DIR="$RELAY_DIR/overrides"
HOSTS_TAG="codex-relay-manager"

mkdir -p "$CODEX_DIR" "$RELAY_DIR" "$RELAY_DIR/backups/config" "$RELAY_DIR/backups/auth" "$RELAY_DIR/backups/history" "$SECRETS_DIR" "$AUTH_DIR" "$CACHE_DIR" "$OVERRIDES_DIR"
chmod 700 "$RELAY_DIR" "$SECRETS_DIR" "$AUTH_DIR" "$CACHE_DIR" "$OVERRIDES_DIR" 2>/dev/null || true
rm -f "$CACHE_DIR/official-quota.json" 2>/dev/null || true

# 从旧版 ~/.codex 中迁移少量 relay 状态文件。只迁移管理器自己的文件，
# 不触碰 auth.json、sessions、SQLite 或其他 Codex 数据。
migrate_legacy_relay_state() {
    if [[ ! -e "$CURRENT" && -f "$CODEX_DIR/.relay-current" ]]; then
        mv "$CODEX_DIR/.relay-current" "$CURRENT"
    fi
    if [[ ! -e "$REGISTRY" && -f "$CODEX_DIR/relays.tsv" ]]; then
        mv "$CODEX_DIR/relays.tsv" "$REGISTRY"
    fi
    if [[ ! -e "$OFFICIAL_MODEL_FILE" && -f "$CODEX_DIR/.official-model" ]]; then
        mv "$CODEX_DIR/.official-model" "$OFFICIAL_MODEL_FILE"
    fi
    if [[ ! -e "$LANGUAGE_FILE" && -f "$CODEX_DIR/.relay-language" ]]; then
        mv "$CODEX_DIR/.relay-language" "$LANGUAGE_FILE"
    fi
}
migrate_legacy_relay_state

touch "$REGISTRY"

# -----------------------------
# 基础工具
# -----------------------------
die() {
    echo "ERROR: $*" >&2
    exit 1
}

need() {
    command -v "$1" >/dev/null 2>&1 || die "缺少命令: $1"
}

clean_proxy_env() {
    unset http_proxy https_proxy HTTP_PROXY HTTPS_PROXY all_proxy ALL_PROXY || true
}

is_ipv4() {
    [[ "$1" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]
}

# -----------------------------
# 当前用户 Codex 进程 / 服务
# -----------------------------
codex_process_pids() {
    local uid proc pid exe base comm
    uid="$(id -u)"

    for proc in /proc/[0-9]*; do
        [[ -d "$proc" ]] || continue
        pid="${proc##*/}"

        [[ "$(stat -c '%u' "$proc" 2>/dev/null || true)" == "$uid" ]] || continue

        exe="$(readlink -f "$proc/exe" 2>/dev/null || true)"
        base="${exe##*/}"
        comm="$(cat "$proc/comm" 2>/dev/null || true)"

        case "$base:$comm" in
            codex-relay:*|*:codex-relay|codex-relay-*:*|*:codex-relay-*)
                continue
                ;;
            codex:*|codex-*:*|*:codex|*:codex-*)
                printf '%s\n' "$pid"
                ;;
        esac
    done
}

codex_process_count() {
    local count=0 _
    while IFS= read -r _; do
        [[ -n "$_" ]] && count=$((count + 1))
    done < <(codex_process_pids)
    printf '%s' "$count"
}

cmd_services() {
    ui_header "$(L '当前用户 Codex 服务' 'CURRENT USER CODEX SERVICES')"
    ui_kv "$(L '用户' 'user')" "$(id -un)"
    ui_kv "UID" "$(id -u)"
    printf '\n'

    local found=0 pid exe args
    while IFS= read -r pid; do
        [[ -n "$pid" ]] || continue
        found=1
        exe="$(readlink -f "/proc/$pid/exe" 2>/dev/null || true)"
        args="$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null || true)"
        printf '  PID %-7s %s\n' "$pid" "${args:-$exe}"
    done < <(codex_process_pids)

    if [[ "$found" == "0" ]]; then
        ui_ok "$(L '当前用户没有运行中的 Codex 进程' 'No Codex processes are running for this user')"
    else
        printf '\n'
        ui_info "$(L '停止当前用户全部 Codex: cr stop' 'Stop all Codex processes for this user: cr stop')"
    fi
}

cmd_stop() {
    ui_header "$(L '停止当前用户全部 Codex' 'STOP ALL CODEX FOR CURRENT USER')"
    ui_warn "$(L '这会中断当前用户正在运行或排队的 Codex 工作，不影响其他 Linux 用户。' 'This interrupts running or queued Codex work for the current user only.')"
    ui_kv "$(L '用户' 'user')" "$(id -un)"
    ui_kv "UID" "$(id -u)"
    printf '\n'

    local before pid remaining deadline
    before="$(codex_process_count)"

    if command -v codex >/dev/null 2>&1; then
        ui_step "$(L '先请求官方 app-server daemon 优雅停止' 'Requesting graceful app-server daemon stop first')"
        if codex app-server daemon stop >/dev/null 2>&1; then
            ui_ok "$(L 'daemon stop 已完成' 'daemon stop completed')"
        else
            ui_warn "$(L '官方 daemon stop 未成功或当前没有托管 daemon，继续清理当前用户残留 Codex 进程' 'Managed daemon stop failed or no managed daemon exists; continuing with current-user Codex processes')"
        fi
    fi

    mapfile -t remaining < <(codex_process_pids)
    if (( ${#remaining[@]} > 0 )); then
        ui_step "$(L '向残留 Codex 进程发送 TERM' 'Sending TERM to remaining Codex processes')"
        for pid in "${remaining[@]}"; do
            kill -TERM "$pid" 2>/dev/null || true
        done

        deadline=$((SECONDS + 5))
        while (( SECONDS < deadline )); do
            [[ "$(codex_process_count)" == "0" ]] && break
            sleep 0.2
        done
    fi

    mapfile -t remaining < <(codex_process_pids)
    if (( ${#remaining[@]} > 0 )); then
        ui_warn "$(L '仍有 Codex 进程未退出，发送 KILL' 'Some Codex processes remain; sending KILL')"
        for pid in "${remaining[@]}"; do
            kill -KILL "$pid" 2>/dev/null || true
        done
        sleep 0.2
    fi

    rm -f "$AUTH_RELOAD_FLAG"

    if [[ "$(codex_process_count)" == "0" ]]; then
        ui_ok "$(L "已停止当前用户全部 Codex（原检测到 $before 个进程）" "Stopped all Codex processes for this user (initially found $before)")"
        ui_info "$(L '现在可以安全进行聊天历史修复、重建索引或维护 auth/config。' 'You can now repair history, rebuild indexes, or maintain auth/config.')"
        return 0
    fi

    ui_fail "$(L '仍检测到 Codex 进程，请运行 cr services 查看' 'Codex processes still remain; run cr services to inspect them')"
    return 1
}

require_codex_stopped() {
    if [[ "$(codex_process_count)" != "0" ]]; then
        ui_warn "$(L '检测到当前用户仍有 Codex 服务/进程运行。' 'Codex services/processes are still running for this user.')"
        ui_info "$(L '请先执行: cr stop' 'Run first: cr stop')"
        return 1
    fi
    return 0
}


# -----------------------------
# 语言 / Language
# -----------------------------
detect_relay_language() {
    local lang="zh"
    if [[ -s "$LANGUAGE_FILE" ]]; then
        IFS= read -r lang < "$LANGUAGE_FILE" || true
        lang="${lang//[[:space:]]/}"
    fi
    case "$lang" in
        en|en-US|en_US) echo "en" ;;
        *) echo "zh" ;;
    esac
}

RELAY_LANG="$(detect_relay_language)"

L() {
    local zh="$1" en="$2"
    if [[ "$RELAY_LANG" == "en" ]]; then
        printf '%s' "$en"
    else
        printf '%s' "$zh"
    fi
}

cmd_language() {
    local requested="${1:-}"

    case "$requested" in
        "")
            ui_header "$(L '语言设置' 'LANGUAGE')"
            ui_kv "$(L '当前语言' 'language')" "$RELAY_LANG"
            printf '\n'
            if [[ "$RELAY_LANG" == "en" ]]; then
                echo "  cr language zh    Switch to Chinese (default)"
                echo "  cr language en    Use English"
            else
                echo "  cr language zh    切换到中文（默认）"
                echo "  cr language en    切换到 English"
            fi
            ;;
        zh|zh-CN|zh_CN|cn|中文)
            RELAY_LANG="zh"
            printf '%s\n' "zh" > "$LANGUAGE_FILE"
            ui_ok "语言已切换为中文"
            ;;
        en|en-US|en_US|english|English)
            RELAY_LANG="en"
            printf '%s\n' "en" > "$LANGUAGE_FILE"
            ui_ok "Language switched to English"
            ;;
        *)
            if [[ "$RELAY_LANG" == "en" ]]; then
                die "Unknown language: $requested (use zh or en)"
            else
                die "未知语言: $requested（可用 zh 或 en）"
            fi
            ;;
    esac
}

cmd_language_menu() {
    while true; do
        clear || true
        ui_header "$(L '语言设置' 'LANGUAGE')"
        ui_kv "$(L '当前语言' 'current')" "$RELAY_LANG"
        printf '\n'
        ui_menu_item "1" "中文" "$(L '默认语言' 'default language')"
        ui_menu_item "2" "English" "$(L '英文界面' 'English interface')"
        ui_menu_item "0" "$(L '返回' 'Back')" ""
        printf '\n%s›%s %s%s%s  ' "$UI_PINK" "$UI_RESET" "$UI_BOLD" "$(L '选择语言' 'Choose language')" "$UI_RESET"
        read -r choice
        case "$choice" in
            1) cmd_language zh; sleep 0.4; return ;;
            2) cmd_language en; sleep 0.4; return ;;
            0|q|Q) return ;;
            *) ui_warn "$(L "无效选择: $choice" "Invalid choice: $choice")"; sleep 0.7 ;;
        esac
    done
}


# -----------------------------
# UI / 终端视觉层
# -----------------------------
ui_init() {
    if [[ -t 1 && "${TERM:-}" != "dumb" && -z "${NO_COLOR:-}" ]]; then
        UI_RESET=$'\033[0m'
        UI_BOLD=$'\033[1m'
        UI_DIM=$'\033[2m'
        UI_CYAN=$'\033[38;5;51m'
        UI_BLUE=$'\033[38;5;75m'
        UI_PURPLE=$'\033[38;5;141m'
        UI_PINK=$'\033[38;5;213m'
        UI_GREEN=$'\033[38;5;84m'
        UI_YELLOW=$'\033[38;5;220m'
        UI_RED=$'\033[38;5;203m'
        UI_GRAY=$'\033[38;5;245m'
        UI_WHITE=$'\033[38;5;255m'
        UI_BG=$'\033[48;5;236m'
    else
        UI_RESET="" UI_BOLD="" UI_DIM="" UI_CYAN="" UI_BLUE=""
        UI_PURPLE="" UI_PINK="" UI_GREEN="" UI_YELLOW="" UI_RED=""
        UI_GRAY="" UI_WHITE="" UI_BG=""
    fi
}
ui_init

ui_width() {
    if [[ -n "${UI_WIDTH_CACHE:-}" ]]; then
        printf '%s' "$UI_WIDTH_CACHE"
        return
    fi

    local w="${COLUMNS:-}"
    if [[ -z "$w" ]] && command -v tput >/dev/null 2>&1; then
        w="$(tput cols 2>/dev/null || true)"
    fi
    [[ "$w" =~ ^[0-9]+$ ]] || w=80
    (( w > 92 )) && w=92
    (( w < 64 )) && w=64
    UI_WIDTH_CACHE="$w"
    printf '%s' "$UI_WIDTH_CACHE"
}

ui_rule() {
    local w i
    w="$(ui_width)"
    printf '%s' "$UI_DIM$UI_BLUE"
    for ((i=0; i<w; i++)); do printf '─'; done
    printf '%s\n' "$UI_RESET"
}

ui_header() {
    local subtitle="${1:-CONTROL CENTER}"
    local w inner title pad_l pad_r i
    w="$(ui_width)"
    inner=$((w-2))
    title=" CODEX RELAY // ${subtitle} "
    pad_l=$(((inner-${#title})/2))
    (( pad_l < 0 )) && pad_l=0
    pad_r=$((inner-${#title}-pad_l))
    (( pad_r < 0 )) && pad_r=0

    printf '%s╭' "$UI_CYAN"
    for ((i=0; i<inner; i++)); do printf '─'; done
    printf '╮%s\n' "$UI_RESET"
    printf '%s│%s' "$UI_CYAN" "$UI_RESET"
    printf '%*s' "$pad_l" ''
    printf '%s%s%s%s' "$UI_BOLD" "$UI_PINK" "$title" "$UI_RESET"
    printf '%*s' "$pad_r" ''
    printf '%s│%s\n' "$UI_CYAN" "$UI_RESET"
    printf '%s╰' "$UI_CYAN"
    for ((i=0; i<inner; i++)); do printf '─'; done
    printf '╯%s\n' "$UI_RESET"
}

ui_section() {
    printf '\n%s◆ %s%s%s\n' "$UI_PURPLE" "$UI_BOLD" "$*" "$UI_RESET"
}

ui_kv() {
    local k="$1" v="${2:-}"
    printf '  %s%-11s%s %s%s%s\n' "$UI_GRAY" "$k" "$UI_RESET" "$UI_WHITE" "$v" "$UI_RESET"
}

ui_ok()   { printf '%s✓%s %s\n' "$UI_GREEN" "$UI_RESET" "$*"; }
ui_fail() { printf '%s✕%s %s\n' "$UI_RED" "$UI_RESET" "$*" >&2; }
ui_warn() { printf '%s!%s %s\n' "$UI_YELLOW" "$UI_RESET" "$*"; }
ui_info() { printf '%s●%s %s\n' "$UI_CYAN" "$UI_RESET" "$*"; }
ui_step() { printf '%s↻%s %s%s%s\n' "$UI_BLUE" "$UI_RESET" "$UI_BOLD" "$*" "$UI_RESET"; }

ui_pause() {
    local _
    printf '\n%s按 Enter 返回…%s' "$UI_DIM" "$UI_RESET"
    read -r _
}

proxy_env_detected() {
    [[ -n "${http_proxy:-}${https_proxy:-}${HTTP_PROXY:-}${HTTPS_PROXY:-}${all_proxy:-}${ALL_PROXY:-}" ]]
}

ui_proxy_state() {
    if proxy_env_detected; then
        printf '%sDETECTED%s' "$UI_YELLOW" "$UI_RESET"
    else
        printf '%sCLEAN%s' "$UI_GREEN" "$UI_RESET"
    fi
}

ui_profile_card() {
    local name provider model url reasoning
    name="$(current_profile)"
    if profile_exists "$name"; then
        load_profile "$name"
        provider="$P_PROVIDER"
        model="$P_MODEL"
        url="$P_URL"
        reasoning="$P_REASONING"
    else
        provider="?" model="?" url="?" reasoning=""
    fi

    printf '\n%s┌─ ACTIVE PROFILE %s' "$UI_BLUE" "$UI_RESET"
    printf '%s' "$UI_DIM"
    printf '────────────────────────────────────────'
    printf '%s\n' "$UI_RESET"
    printf '  %s%-10s%s %s%s%s\n' "$UI_GRAY" 'profile' "$UI_RESET" "$UI_BOLD$UI_CYAN" "$name" "$UI_RESET"
    printf '  %s%-10s%s %s\n' "$UI_GRAY" 'provider' "$UI_RESET" "$provider"
    printf '  %s%-10s%s %s\n' "$UI_GRAY" 'model' "$UI_RESET" "$model"
    [[ -n "$reasoning" ]] && printf '  %s%-10s%s %s\n' "$UI_GRAY" 'reasoning' "$UI_RESET" "$reasoning"
    printf '  %s%-10s%s %s\n' "$UI_GRAY" 'endpoint' "$UI_RESET" "$url"
    printf '  %s%-10s%s ' "$UI_GRAY" 'shell proxy' "$UI_RESET"
    ui_proxy_state
    printf '\n'
    printf '%s└────────────────────────────────────────────────────%s\n' "$UI_BLUE" "$UI_RESET"
}

ui_menu_item() {
    local key="$1" label="$2" hint="${3:-}"
    printf '  %s[%2s]%s  %s%-28s%s %s%s%s\n' \
        "$UI_CYAN" "$key" "$UI_RESET" \
        "$UI_WHITE" "$label" "$UI_RESET" \
        "$UI_DIM" "$hint" "$UI_RESET"
}

# -----------------------------
# Profile 定义
# -----------------------------
# 输出变量：
# P_NAME P_KIND P_PROVIDER P_URL P_MODEL P_REASONING P_REVIEW P_GOALS P_AUTH
load_profile() {
    local name="$1"

    P_NAME="$name"
    P_KIND="custom"
    P_PROVIDER=""
    P_URL=""
    P_MODEL=""
    P_REASONING=""
    P_REVIEW=""
    P_GOALS="false"
    P_AUTH="openai"

    case "$name" in
        baibai)
            P_PROVIDER="baibai"
            P_URL="https://api.sharesai.xyz/v1"
            P_MODEL="gpt-5.6-sol"
            P_REASONING="xhigh"
            P_AUTH="relay"
            ;;

        nova)
            P_PROVIDER="OpenAI"
            P_URL="https://ai.novacode.top"
            P_MODEL="gpt-5.5"
            P_REVIEW="gpt-5.5"
            P_GOALS="true"
            P_AUTH="relay"
            ;;

        official)
            P_KIND="official"
            P_PROVIDER="openai"
            P_URL="https://api.openai.com/v1"
            [[ -s "$OFFICIAL_MODEL_FILE" ]] || \
                die "官方 OpenAI 尚未设置模型。先运行: cr official MODEL"
            P_MODEL="$(cat "$OFFICIAL_MODEL_FILE")"
            P_AUTH="openai"
            ;;

        *)
            local row
            row="$(awk -F '\t' -v n="$name" '$1==n {print; exit}' "$REGISTRY")"
            [[ -n "$row" ]] || die "没有这个 profile: $name"

            IFS=$'\t' read -r \
                P_NAME P_PROVIDER P_URL P_MODEL P_AUTH P_REASONING P_REVIEW P_GOALS \
                <<< "$row"

            P_KIND="custom"
            P_AUTH="${P_AUTH:-openai}"
            P_GOALS="${P_GOALS:-false}"
            [[ "$P_REASONING" == "-" ]] && P_REASONING=""
            [[ "$P_REVIEW" == "-" ]] && P_REVIEW=""
            ;;
    esac

    local override_file override_key override_value
    override_file="$OVERRIDES_DIR/$name.conf"
    if [[ -f "$override_file" ]]; then
        while IFS='=' read -r override_key override_value; do
            case "$override_key" in
                url)
                    [[ -n "$override_value" ]] && P_URL="$override_value"
                    ;;
                model)
                    [[ -n "$override_value" ]] && P_MODEL="$override_value"
                    ;;
                reasoning)
                    if [[ "$override_value" == "__EMPTY__" ]]; then
                        P_REASONING=""
                    elif [[ -n "$override_value" ]]; then
                        P_REASONING="$override_value"
                    fi
                    ;;
                review)
                    if [[ "$override_value" == "__EMPTY__" ]]; then
                        P_REVIEW=""
                    elif [[ -n "$override_value" ]]; then
                        P_REVIEW="$override_value"
                    fi
                    ;;
            esac
        done < "$override_file"
    fi
}

profile_exists() {
    local name="$1"
    case "$name" in
        baibai|nova)
            return 0
            ;;
        official)
            [[ -s "$OFFICIAL_MODEL_FILE" ]]
            return
            ;;
        *)
            awk -F '\t' -v n="$name" '$1==n {found=1} END{exit !found}' "$REGISTRY"
            ;;
    esac
}

current_profile() {
    local name=""
    if [[ -s "$CURRENT" ]]; then
        IFS= read -r name < "$CURRENT" || true
    fi
    printf '%s\n' "${name:-nova}"
}

# -----------------------------
# 真正修改 ~/.codex/config.toml
# -----------------------------
write_config_for_profile() {
    local name="$1"
    load_profile "$name"

    need python3

    local stamp backup=""
    stamp="$(date +%Y%m%d-%H%M%S)"

    if [[ -f "$CONFIG" ]]; then
        backup="$RELAY_DIR/backups/config/config.toml.$stamp"
        cp -a "$CONFIG" "$backup"
    fi

    python3 - \
        "$CONFIG" \
        "$P_KIND" \
        "$P_PROVIDER" \
        "$P_URL" \
        "$P_MODEL" \
        "$P_REASONING" \
        "$P_REVIEW" \
        "$P_GOALS" \
        "$P_AUTH" <<'PY'
from pathlib import Path
import re
import sys

(
    config_path,
    kind,
    provider,
    base_url,
    model,
    reasoning,
    review_model,
    goals,
    auth,
) = sys.argv[1:]

path = Path(config_path)
text = path.read_text(encoding="utf-8", errors="replace") if path.exists() else ""
lines = text.splitlines()

managed_root = {
    "model_provider",
    "model",
    "review_model",
    "model_reasoning_effort",
    "disable_response_storage",
    "model_catalog_json",  # 关键：切换时清掉旧的无效 catalog 路径
    "network_access",
    "windows_wsl_setup_acknowledged",
}

section_re = re.compile(r"^\s*\[([^\]]+)\]\s*(?:#.*)?$")
key_re = re.compile(r"^\s*([A-Za-z0-9_-]+)\s*=")
managed_provider_sections = {
    "model_providers.baibai",
    "model_providers.baibai.auth",
    "model_providers.OpenAI",
    "model_providers.OpenAI.auth",
}
if kind == "custom":
    managed_provider_sections.add(f"model_providers.{provider}")
    managed_provider_sections.add(f"model_providers.{provider}.auth")

out = []
section = None
skip_section = False

for line in lines:
    sm = section_re.match(line)
    if sm:
        section = sm.group(1).strip()
        skip_section = section in managed_provider_sections
        if skip_section:
            continue
        out.append(line)
        continue

    if skip_section:
        continue

    km = key_re.match(line)
    if km:
        key = km.group(1)
        if section is None and key in managed_root:
            continue
        if section == "features" and key == "goals":
            continue

    out.append(line)

# 清理开头多余空行
while out and not out[0].strip():
    out.pop(0)

# 如 Nova 需要 goals=true，则合并进已有 [features]；否则不写 goals
if goals.lower() == "true":
    feature_idx = None
    for i, line in enumerate(out):
        sm = section_re.match(line)
        if sm and sm.group(1).strip() == "features":
            feature_idx = i
            break

    if feature_idx is not None:
        out.insert(feature_idx + 1, "goals = true")
    else:
        if out and out[-1].strip():
            out.append("")
        out.extend(["[features]", "goals = true"])

# 新的顶层配置永远放在最前面
root = [
    f'model_provider = "{provider}"',
    f'model = "{model}"',
]

if review_model:
    root.append(f'review_model = "{review_model}"')
if reasoning:
    root.append(f'model_reasoning_effort = "{reasoning}"')

root.extend([
    'network_access = "enabled"',
    'disable_response_storage = true',
])

if kind == "custom" and provider == "OpenAI":
    root.append("windows_wsl_setup_acknowledged = true")

# 注意：这里故意不写 model_catalog_json。
# 之前 ~/.codex/codex-models.json 不存在，会导致 Codex 启动时报 os error 2。

result = root + [""] + out

# 自定义 provider 追加/重建 provider section
if kind == "custom":
    if result and result[-1].strip():
        result.append("")

    result.extend([
        f"[model_providers.{provider}]",
        'name = "OpenAI"',
        f'base_url = "{base_url}"',
        'wire_api = "responses"',
    ])

    if auth in {"openai", "relay"}:
        result.append("requires_openai_auth = true")
    elif auth.startswith("env:"):
        var = auth.split(":", 1)[1]
        result.extend([
            "requires_openai_auth = false",
            f'env_key = "{var}"',
        ])
    elif auth == "none":
        result.append("requires_openai_auth = false")
    else:
        raise SystemExit(f"unknown auth mode: {auth}")

# 去掉连续过多空行
clean = []
blank = 0
for line in result:
    if line.strip():
        blank = 0
        clean.append(line.rstrip())
    else:
        blank += 1
        if blank <= 1:
            clean.append("")

path.write_text("\n".join(clean).rstrip() + "\n", encoding="utf-8")
PY

    printf '%s\n' "$name" > "$CURRENT"

    ui_ok "config.toml 已切换 → $name"
    ui_kv "provider" "$P_PROVIDER"
    ui_kv "model" "$P_MODEL"
    [[ -n "$P_REASONING" ]] && ui_kv "reasoning" "$P_REASONING"
    [[ -n "$P_URL" ]] && ui_kv "base_url" "$P_URL"
    [[ -n "$backup" ]] && ui_kv "backup" "$backup"
}

# -----------------------------
# 每用户 Provider 覆盖
# -----------------------------
profile_override_file() {
    printf '%s/%s.conf' "$OVERRIDES_DIR" "$1"
}

profile_override_exists() {
    [[ -s "$(profile_override_file "$1")" ]]
}

save_profile_override() {
    local name="$1" url="$2" model="$3" reasoning="$4" review="$5" file tmp
    [[ -n "$reasoning" ]] || reasoning="__EMPTY__"
    [[ -n "$review" ]] || review="__EMPTY__"
    file="$(profile_override_file "$name")"
    tmp="$(mktemp "$OVERRIDES_DIR/.override.XXXXXX")"
    {
        printf 'url=%s\n' "$url"
        printf 'model=%s\n' "$model"
        printf 'reasoning=%s\n' "$reasoning"
        printf 'review=%s\n' "$review"
    } > "$tmp"
    mv "$tmp" "$file"
    chmod 600 "$file" 2>/dev/null || true
}

reset_profile_override() {
    rm -f "$(profile_override_file "$1")"
}

profile_names() {
    printf '%s\n' nova baibai
    [[ -s "$OFFICIAL_MODEL_FILE" ]] && printf '%s\n' official
    awk -F '\t' 'NF && $1!="nova" && $1!="baibai" && $1!="official" && !seen[$1]++ {print $1}' "$REGISTRY"
}

cmd_model() {
    [[ $# -ge 2 && $# -le 3 ]] || die "$(L '用法: cr model PROFILE MODEL [REASONING|auto|keep]' 'Usage: cr model PROFILE MODEL [REASONING|auto|keep]')"
    local name="$1" new_model="$2" reasoning_arg="${3:-auto}"
    local old_model old_review new_reasoning=""

    profile_exists "$name" || die "$(L "没有这个 profile: $name" "Unknown profile: $name")"

    if [[ "$name" == "official" ]]; then
        printf '%s\n' "$new_model" > "$OFFICIAL_MODEL_FILE"
        [[ "$(current_profile)" == "$name" ]] && write_config_for_profile "$name"
        ui_ok "$(L "$name 默认模型 → $new_model" "$name default model → $new_model")"
        return 0
    fi

    load_profile "$name"
    old_model="$P_MODEL"
    old_review="$P_REVIEW"
    [[ -n "$old_review" && "$old_review" == "$old_model" ]] && old_review="$new_model"

    case "${reasoning_arg,,}" in
        auto|"")
            new_reasoning=""
            ;;
        keep)
            new_reasoning="$P_REASONING"
            ;;
        *)
            new_reasoning="${reasoning_arg,,}"
            [[ "$new_reasoning" =~ ^[A-Za-z0-9._-]+$ ]] || \
                die "$(L 'REASONING 格式非法，只能使用字母、数字、点、下划线和短横线' 'Invalid REASONING; use letters, numbers, dot, underscore, or hyphen')"
            ;;
    esac

    save_profile_override "$name" "$P_URL" "$new_model" "$new_reasoning" "$old_review"
    [[ "$(current_profile)" == "$name" ]] && write_config_for_profile "$name"

    ui_ok "$(L "$name 默认模型 → $new_model" "$name default model → $new_model")"
    if [[ -n "$new_reasoning" ]]; then
        ui_info "$(L "推理强度 → $new_reasoning" "reasoning effort → $new_reasoning")"
    else
        ui_info "$(L '推理强度 → Auto（不写 model_reasoning_effort）' 'reasoning effort → Auto (model_reasoning_effort unset)')"
    fi
}

cmd_endpoint() {
    [[ $# -eq 2 ]] || die "$(L '用法: cr endpoint PROFILE URL' 'Usage: cr endpoint PROFILE URL')"
    local name="$1" url="$2"
    profile_exists "$name" || die "$(L "没有这个 profile: $name" "Unknown profile: $name")"
    [[ "$url" =~ ^https?:// ]] || die "$(L 'URL 必须以 http:// 或 https:// 开头' 'URL must start with http:// or https://')"
    [[ "$name" != "official" ]] || die "$(L '官方 OpenAI 地址不可修改' 'Official OpenAI endpoint cannot be changed')"
    load_profile "$name"
    save_profile_override "$name" "$url" "$P_MODEL" "$P_REASONING" "$P_REVIEW"
    [[ "$(current_profile)" == "$name" ]] && write_config_for_profile "$name"
    ui_ok "$(L "$name API 地址已更新" "$name endpoint updated")"
}

cmd_speed() {
    local name="${1:-$(current_profile)}" result code sec ms
    load_profile "$name"
    need curl
    result="$(env -u http_proxy -u https_proxy -u HTTP_PROXY -u HTTPS_PROXY -u all_proxy -u ALL_PROXY \
        curl --noproxy '*' -4 -sS -o /dev/null -w '%{http_code} %{time_total}' \
        --connect-timeout 7 --max-time 15 "$P_URL" 2>/dev/null)" || {
        ui_fail "$(L '连接失败' 'Connection failed')"
        return 1
    }
    code="${result%% *}"
    sec="${result#* }"
    [[ "$code" != "000" ]] || { ui_fail "$(L '连接失败' 'Connection failed')"; return 1; }
    ms="$(awk -v t="$sec" 'BEGIN{printf "%.0f",t*1000}')"
    ui_ok "$(L "$name 可达 · HTTP $code · ${ms} ms" "$name reachable · HTTP $code · ${ms} ms")"
}

cmd_delete_profile() {
    [[ $# -eq 1 ]] || die "$(L '用法: cr delete PROFILE' 'Usage: cr delete PROFILE')"
    local name="$1" tmp
    case "$name" in
        nova|baibai|official) die "$(L '内置中转站不能删除' 'Built-in providers cannot be deleted')" ;;
    esac
    profile_exists "$name" || die "$(L "没有这个 profile: $name" "Unknown profile: $name")"
    tmp="$(mktemp)"
    awk -F '\t' -v n="$name" '$1 != n' "$REGISTRY" > "$tmp"
    mv "$tmp" "$REGISTRY"
    reset_profile_override "$name"
    rm -f "$(key_file_for_profile "$name")"
    [[ "$(current_profile)" == "$name" ]] && write_config_for_profile nova
    ui_ok "$(L "已删除: $name" "Deleted: $name")"
}

# -----------------------------
# 官方 Codex auth.json 切换
# -----------------------------
auth_json_mode() {
    [[ -f "$AUTH_FILE" ]] || return 0
    python3 - "$AUTH_FILE" <<'PY'
import json
import sys
from pathlib import Path

path = Path(sys.argv[1])
try:
    data = json.loads(path.read_text(encoding="utf-8"))
except Exception:
    raise SystemExit(0)
mode = data.get("auth_mode")
if isinstance(mode, str):
    print(mode)
PY
}

backup_auth_json() {
    [[ -f "$AUTH_FILE" ]] || return 0
    local stamp backup
    stamp="$(date +%Y%m%d-%H%M%S)"
    backup="$RELAY_DIR/backups/auth/auth.json.$stamp"
    cp -a "$AUTH_FILE" "$backup"
    chmod 600 "$backup" 2>/dev/null || true
}

capture_official_auth_if_needed() {
    [[ -f "$AUTH_FILE" ]] || return 0
    [[ ! -f "$OFFICIAL_AUTH_FILE" ]] || return 0

    local mode current
    mode="$(auth_json_mode || true)"
    current="$(current_profile)"

    case "$mode" in
        chatgpt|chatgptauthtokens)
            cp -a "$AUTH_FILE" "$OFFICIAL_AUTH_FILE"
            chmod 600 "$OFFICIAL_AUTH_FILE" 2>/dev/null || true
            ;;
        *)
            if [[ "$current" == "official" ]]; then
                cp -a "$AUTH_FILE" "$OFFICIAL_AUTH_FILE"
                chmod 600 "$OFFICIAL_AUTH_FILE" 2>/dev/null || true
            fi
            ;;
    esac
}

write_native_api_auth() {
    local name="$1" key tmp same="false"
    ensure_relay_key "$name"
    key="$(read_relay_key "$name")"

    tmp="$(mktemp "$AUTH_DIR/.auth.XXXXXX")"
    chmod 600 "$tmp"

    python3 - "$tmp" "$key" <<'PY'
import json
import sys
from pathlib import Path

path = Path(sys.argv[1])
key = sys.argv[2]
data = {
    "auth_mode": "apikey",
    "OPENAI_API_KEY": key,
}
path.write_text(json.dumps(data, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
PY

    if [[ -f "$AUTH_FILE" ]]; then
        if python3 - "$AUTH_FILE" "$tmp" <<'PY'
import json
import sys
from pathlib import Path

try:
    left = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
    right = json.loads(Path(sys.argv[2]).read_text(encoding="utf-8"))
except Exception:
    raise SystemExit(1)
raise SystemExit(0 if left == right else 1)
PY
        then
            same="true"
        fi
    fi

    if [[ "$same" == "true" ]]; then
        rm -f "$tmp"
        AUTH_CHANGED=0
        return 0
    fi

    backup_auth_json
    mv "$tmp" "$AUTH_FILE"
    chmod 600 "$AUTH_FILE" 2>/dev/null || true
    AUTH_CHANGED=1
    : > "$AUTH_RELOAD_FLAG"
}

restore_official_auth() {
    AUTH_CHANGED=0
    if [[ ! -f "$OFFICIAL_AUTH_FILE" ]]; then
        if [[ -f "$AUTH_FILE" ]]; then
            backup_auth_json
            rm -f "$AUTH_FILE"
            AUTH_CHANGED=1
            : > "$AUTH_RELOAD_FLAG"
        fi
        ui_warn "$(L '没有保存的官方 Codex 登录；已移除中转站认证，启动官方 Codex 后请登录一次' 'No saved official Codex login; relay auth was removed. Sign in once after launching official Codex')"
        return 0
    fi

    if [[ -f "$AUTH_FILE" ]] && cmp -s "$AUTH_FILE" "$OFFICIAL_AUTH_FILE"; then
        return 0
    fi

    backup_auth_json
    cp -a "$OFFICIAL_AUTH_FILE" "$AUTH_FILE"
    chmod 600 "$AUTH_FILE" 2>/dev/null || true
    AUTH_CHANGED=1
    : > "$AUTH_RELOAD_FLAG"
}

apply_auth_for_profile() {
    local name="$1"
    AUTH_CHANGED=0
    load_profile "$name"

    if [[ "$name" == "official" ]]; then
        restore_official_auth
        return 0
    fi

    if [[ "$P_AUTH" == "relay" ]]; then
        capture_official_auth_if_needed
        write_native_api_auth "$name"
    fi
}

refresh_daemon_after_auth_change() {
    [[ -f "$AUTH_RELOAD_FLAG" ]] || return 0
    command -v codex >/dev/null 2>&1 || return 0

    if codex app-server daemon stop >/dev/null 2>&1; then
        rm -f "$AUTH_RELOAD_FLAG"
        ui_info "$(L '认证已切换，已在启动前刷新 Codex 后台服务' 'Auth changed; refreshed the Codex daemon before launch')"
    else
        ui_warn "$(L 'auth.json 已更新，但后台服务刷新失败；如仍使用旧认证，请执行: codex app-server daemon stop' 'auth.json updated but daemon refresh failed; if old auth persists, run: codex app-server daemon stop')"
    fi
}

# -----------------------------
# 每用户 / 每 Profile API Key
# -----------------------------
key_file_for_profile() {
    printf '%s/%s.key' "$SECRETS_DIR" "$1"
}

relay_key_exists() {
    [[ -s "$(key_file_for_profile "$1")" ]]
}

save_relay_key() {
    local name="$1" key="$2" file tmp
    [[ -n "$key" ]] || die "$(L 'API Key 不能为空' 'API key cannot be empty')"
    file="$(key_file_for_profile "$name")"
    tmp="$(mktemp "$SECRETS_DIR/.key.XXXXXX")"
    chmod 600 "$tmp"
    printf '%s' "$key" > "$tmp"
    mv "$tmp" "$file"
    chmod 600 "$file" 2>/dev/null || true
}

read_relay_key() {
    local file key=""
    file="$(key_file_for_profile "$1")"
    [[ -s "$file" ]] || return 1
    IFS= read -r key < "$file" || true
    printf '%s' "$key"
}

prompt_relay_key() {
    local name="$1" key
    printf '%s' "$(L "请输入 $name 的 API Key（输入不会显示）: " "Enter API key for $name (hidden): ")"
    IFS= read -r -s key
    printf '\n'
    [[ -n "$key" ]] || die "$(L 'API Key 不能为空' 'API key cannot be empty')"
    save_relay_key "$name" "$key"
    ui_ok "$(L "已保存 $name 的 API Key（仅当前用户）" "Saved API key for $name (current user only)")"
}

ensure_relay_key() {
    relay_key_exists "$1" || prompt_relay_key "$1"
}

cmd_key() {
    local action="${1:-list}" name="${2:-}"
    case "$action" in
        set)
            [[ -n "$name" ]] || die "$(L '用法: cr key set PROFILE' 'Usage: cr key set PROFILE')"
            load_profile "$name"
            [[ "$P_AUTH" == "relay" ]] || die "$(L '这个 profile 不是 relay 托管 Key 模式' 'This profile does not use relay-managed keys')"
            prompt_relay_key "$name"
            if [[ "$(current_profile)" == "$name" ]]; then
                apply_auth_for_profile "$name"
                ui_warn "$(L '当前正在使用这个中转站；API Key 已更新，将自动停止当前用户的 Codex 服务/进程，使新认证立即生效。' 'This provider is active; the API key changed, so current-user Codex services/processes will be stopped to apply the new auth immediately.')"
                cmd_stop || true
            fi
            ;;
        remove|rm|delete)
            [[ -n "$name" ]] || die "$(L '用法: cr key remove PROFILE' 'Usage: cr key remove PROFILE')"
            rm -f "$(key_file_for_profile "$name")"
            if [[ "$(current_profile)" == "$name" && "$(auth_json_mode || true)" == "apikey" ]]; then
                backup_auth_json
                rm -f "$AUTH_FILE"
                AUTH_CHANGED=1
                : > "$AUTH_RELOAD_FLAG"
                ui_warn "$(L '当前正在使用这个中转站；API Key 已删除，将自动停止当前用户的 Codex 服务/进程。' 'This provider is active; its API key was removed, so current-user Codex services/processes will be stopped.')"
                cmd_stop || true
            fi
            ui_ok "$(L "已删除 $name 的本地 API Key" "Removed local API key for $name")"
            ;;
        list|status|"")
            ui_header "$(L 'API KEY 管理' 'API KEY MANAGEMENT')"
            ui_kv "$(L '密钥目录' 'secret dir')" "$SECRETS_DIR"
            printf '\n'
            local p state
            while read -r p; do
                [[ -n "$p" ]] || continue
                load_profile "$p"
                [[ "$P_AUTH" == "relay" ]] || continue
                if relay_key_exists "$p"; then state="$(L '已设置 ✓' 'SET ✓')"; else state="$(L '未设置' 'NOT SET')"; fi
                printf '  %-12s %s\n' "$p" "$state"
            done < <(profile_names)
            printf '\n'
            ui_info "$(L 'Key 不写入 config.toml；激活中转站时会按 Codex 官方格式写入 ~/.codex/auth.json' 'Keys are not written to config.toml; activating a relay writes native Codex auth.json')"
            ;;
        *)
            die "$(L '用法: cr key [list|set PROFILE|remove PROFILE]' 'Usage: cr key [list|set PROFILE|remove PROFILE]')"
            ;;
    esac
}


cmd_key_profile_menu() {
    local name="$1" choice state current confirm
    while true; do
        load_profile "$name"
        [[ "$P_AUTH" == "relay" ]] || return
        current="$(current_profile)"
        if relay_key_exists "$name"; then
            state="$(L '✓ KEY SET' '✓ KEY SET')"
        else
            state="$(L '✕ NO KEY' '✕ NO KEY')"
        fi

        clear || true
        ui_header "CREDENTIAL // ${name^^}"
        ui_section "$(L '状态' 'STATUS')"
        ui_kv "profile" "$name"
        ui_kv "provider" "$P_PROVIDER"
        ui_kv "model" "$P_MODEL"
        ui_kv "API Key" "$state"
        if [[ "$current" == "$name" ]]; then
            ui_kv "$(L '路由' 'route')" "$(L '● ACTIVE' '● ACTIVE')"
        else
            ui_kv "$(L '路由' 'route')" "$(L '○ STANDBY' '○ STANDBY')"
        fi

        ui_section "$(L '操作' 'ACTIONS')"
        ui_menu_item "U" "$(L '设置 / 更新 API Key' 'Set / update API key')" "$(L '输入过程隐藏' 'hidden input')"
        if relay_key_exists "$name"; then
            ui_menu_item "D" "$(L '删除 API Key' 'Remove API key')" "$(L '危险操作 · 需要确认' 'destructive · confirmation required')"
        fi
        ui_menu_item "0" "$(L '返回' 'Back')" ""

        printf '\n%s›%s ' "$UI_PINK" "$UI_RESET"
        read -r choice
        case "$choice" in
            u|U)
                cmd_key set "$name"
                ui_pause
                ;;
            d|D)
                relay_key_exists "$name" || continue
                clear || true
                ui_header "$(L '确认删除 API KEY' 'CONFIRM KEY REMOVAL')"
                ui_warn "$(L "将删除当前用户保存的 $name API Key。" "This removes the saved $name API key for the current user.")"
                if [[ "$current" == "$name" ]]; then
                    ui_warn "$(L '该中转站当前正在使用；删除后会自动停止当前用户 Codex。' 'This provider is active; removing its key will stop current-user Codex automatically.')"
                fi
                printf '\n%s' "$(L '输入 DELETE 或“删除”确认: ' 'Type DELETE or remove to confirm: ')"
                IFS= read -r confirm
                case "$confirm" in
                    DELETE|delete|删除|remove|REMOVE)
                        cmd_key remove "$name"
                        ;;
                    *)
                        ui_info "$(L '已取消，没有删除 API Key。' 'Cancelled. API key was not removed.')"
                        ;;
                esac
                ui_pause
                ;;
            0|q|Q)
                return
                ;;
            *)
                ui_warn "$(L '无效选择' 'Invalid choice')"
                sleep 0.5
                ;;
        esac
    done
}

cmd_key_menu() {
    local -a profiles=()
    local p choice i state active mark
    while true; do
        profiles=()
        while IFS= read -r p; do
            [[ -n "$p" ]] || continue
            load_profile "$p"
            [[ "$P_AUTH" == "relay" ]] && profiles+=("$p")
        done < <(profile_names)

        active="$(current_profile)"
        clear || true
        ui_header "$(L '凭据管理' 'CREDENTIALS')"

        ui_section "$(L '当前用户 API Keys' 'CURRENT USER API KEYS')"
        if (( ${#profiles[@]} == 0 )); then
            ui_info "$(L '没有 relay 类型的中转站。' 'No relay-managed providers found.')"
        else
            i=1
            for p in "${profiles[@]}"; do
                if relay_key_exists "$p"; then
                    state="${UI_GREEN}✓ KEY SET${UI_RESET}"
                else
                    state="${UI_RED}✕ NO KEY${UI_RESET}"
                fi
                if [[ "$p" == "$active" ]]; then
                    mark="${UI_GREEN}● ACTIVE${UI_RESET}"
                else
                    mark="${UI_DIM}○ STANDBY${UI_RESET}"
                fi
                printf '\n  %s[%s]%s  %s%-14s%s %b  %b\n' \
                    "$UI_CYAN" "$i" "$UI_RESET" \
                    "$UI_BOLD$UI_WHITE" "${p^^}" "$UI_RESET" \
                    "$state" "$mark"
                load_profile "$p"
                printf '       %s└─%s %s · %s\n' "$UI_DIM" "$UI_RESET" "$P_MODEL" "$(provider_host "$P_URL")"
                i=$((i+1))
            done
        fi

        printf '\n'
        ui_rule
        ui_info "$(L 'Key 只保存在当前用户 ~/.codex-relay/secrets/；不会写入 config.toml。' 'Keys stay in the current user’s ~/.codex-relay/secrets/ and are never written to config.toml.')"
        ui_menu_item "0" "$(L '返回' 'Back')" ""
        printf '\n%s›%s ' "$UI_PINK" "$UI_RESET"
        read -r choice

        case "$choice" in
            0|q|Q)
                return
                ;;
            *)
                if [[ "$choice" =~ ^[0-9]+$ ]] && (( choice >= 1 && choice <= ${#profiles[@]} )); then
                    cmd_key_profile_menu "${profiles[$((choice-1))]}"
                else
                    ui_warn "$(L '无效选择' 'Invalid choice')"
                    sleep 0.5
                fi
                ;;
        esac
    done
}

cmd_switch() {
    [[ $# -eq 1 ]] || die "$(L '用法: cr switch PROFILE' 'Usage: cr switch PROFILE')"
    cmd_use "$1"
    cmd_run
}

cmd_add_interactive() {

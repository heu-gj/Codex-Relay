cmd_search() {
    [[ $# -ge 1 ]] || die "用法: cr search 关键词"
    need python3

    local q="$*"
    python3 - "$CODEX_DIR/state_5.sqlite" "$q" <<'PY'
import sqlite3,sys

db,q=sys.argv[1],sys.argv[2]
c=sqlite3.connect(db)
rows=c.execute("""
SELECT
 id, model_provider, COALESCE(model,''),
 COALESCE(NULLIF(name,''),NULLIF(title,''),NULLIF(first_user_message,''),'(untitled)'),
 cwd
FROM threads
WHERE id LIKE ? OR name LIKE ? OR title LIKE ? OR first_user_message LIKE ?
ORDER BY updated_at DESC
LIMIT 100
""",(f"%{q}%",)*4).fetchall()
c.close()

if not rows:
    print("没有找到匹配聊天")

for row in rows:
    print()
    print("ID      :",row[0])

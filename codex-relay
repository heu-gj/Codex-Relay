        ui_kv "Codex CLI" "$(dashboard_cli_version)"
        ui_kv "daemon" "$(dashboard_daemon_version)"
        ui_kv "$(L '进程' 'processes')" "$(dashboard_process_count)"
        ui_kv "$(L '直连' 'network')" "$(dashboard_network_summary "$name")"
        printf '\n'
        ui_menu_item "1" "$(L '网络诊断' 'Network diagnostics')" "DNS · TCP DNS · HTTPS"
        ui_menu_item "2" "$(L '测速' 'Speed test')" ""
        ui_menu_item "3" "$(L 'Direct 修复' 'Direct repair')" "/etc/hosts"
        ui_menu_item "4" "$(L '查看 Codex 服务' 'Show Codex services')" ""
        ui_menu_item "5" "$(L '停止当前用户全部 Codex' 'Stop all Codex for current user')" ""
        ui_menu_item "R" "$(L '刷新状态' 'Refresh status')" ""
        ui_menu_item "0" "$(L '返回' 'Back')" ""
        printf '\n> '; read -r choice
        case "$choice" in
            1) clear || true; cmd_check "$name" || true; ui_pause ;;
            2) clear || true; cmd_speed "$name" || true; ui_pause ;;
            3) clear || true; cmd_direct "$name" || true; ui_pause ;;
            4) clear || true; cmd_services; ui_pause ;;
            5) clear || true; cmd_stop || true; ui_pause ;;
            r|R) dashboard_refresh "$name"; sleep 0.4 ;;
            0|q|Q) return ;;
            *) ui_warn "$(L '无效选择' 'Invalid choice')"; sleep 0.5 ;;
        esac
    done
}


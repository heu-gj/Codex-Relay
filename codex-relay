    file="$CACHE_DIR/network-$name.txt"
    if [[ -s "$file" ]]; then
        cat "$file"
    else
        printf '%s' "$(L '未检测 · 按 R' 'not checked · press R')"
    fi
}

refresh_dashboard_network() {
    local name="$1" file result code sec ms
    file="$CACHE_DIR/network-$name.txt"
    load_profile "$name"

    result="$(env -u http_proxy -u https_proxy -u HTTP_PROXY -u HTTPS_PROXY -u all_proxy -u ALL_PROXY \
        curl --noproxy '*' -sS -o /dev/null -w '%{http_code} %{time_total}' \
        --connect-timeout 5 --max-time 10 "$P_URL" 2>/dev/null)" || true

    code="${result%% *}"
    sec="${result#* }"
    if [[ -n "$result" && "$code" != "000" ]]; then
        ms="$(awk -v t="$sec" 'BEGIN{printf "%.0f",t*1000}')"
        printf '✓ Direct · %s ms\n' "$ms" > "$file"

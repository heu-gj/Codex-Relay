# -----------------------------
# 网络 / 无 VPN 直连
# -----------------------------
url_host() {
    python3 - "$1" <<'PY'
import sys
from urllib.parse import urlparse
u=urlparse(sys.argv[1])
if not u.hostname:
    raise SystemExit(1)
print(u.hostname)
PY
}

url_port() {
    python3 - "$1" <<'PY'
import sys
from urllib.parse import urlparse
u=urlparse(sys.argv[1])
print(u.port or (443 if u.scheme == "https" else 80))
PY
}

direct_curl() {
    local url="$1"
    clean_proxy_env

    local code
    code="$(
        curl --noproxy '*' -4 -sS \
            -o /dev/null \
            -w '%{http_code}' \
            --connect-timeout 7 \
            --max-time 15 \
            "$url" 2>/dev/null
    )" || return 1

    [[ -n "$code" && "$code" != "000" ]] || return 1
    echo "$code"
}

resolved_curl() {
    local url="$1" host="$2" port="$3" ip="$4"
    clean_proxy_env

    local code
    code="$(
        curl --noproxy '*' -4 -sS \
            -o /dev/null \
            -w '%{http_code}' \
            --resolve "${host}:${port}:${ip}" \
            --connect-timeout 7 \
            --max-time 15 \
            "$url" 2>/dev/null
    )" || return 1

    [[ -n "$code" && "$code" != "000" ]] || return 1
    echo "$code"
}

tcp_dns_ips() {
    local host="$1" dns out
    need dig

    for dns in 8.8.8.8 1.1.1.1; do
        out="$(
            timeout 10 dig +tcp +time=4 +tries=1 \
                @"$dns" "$host" A +short 2>/dev/null || true
        )"

        out="$(printf '%s\n' "$out" | awk '
            /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/ {
                if (!seen[$0]++) print
            }
        ')"

        if [[ -n "$out" ]]; then
            printf '%s\n' "$out"
            return 0
        fi
    done

    return 1
}

install_hosts_entry() {
    local host="$1" ip="$2"

    sudo python3 - "$host" "$ip" "$HOSTS_TAG" <<'PY'
import shutil
import sys
import time
from pathlib import Path

host, new_ip, tag = sys.argv[1:]
p = Path("/etc/hosts")
backup = Path(f"/etc/hosts.codex-relay-backup-{time.strftime('%Y%m%d-%H%M%S')}")
shutil.copy2(p, backup)

out=[]
for line in p.read_text(errors="replace").splitlines():
    stripped=line.strip()
    if not stripped or stripped.startswith("#"):
        out.append(line)
        continue

    body, sep, comment = line.partition("#")
    parts=body.split()
    if len(parts) < 2:
        out.append(line)
        continue

    old_ip=parts[0]
    names=parts[1:]
    if host not in names:
        out.append(line)
        continue

    names=[n for n in names if n != host]
    if names:
        newline=old_ip + "\t" + " ".join(names)
        if sep and comment.strip():
            newline += "\t# " + comment.strip()
        out.append(newline)

out.append(f"{new_ip}\t{host}\t# {tag}")
p.write_text("\n".join(out) + "\n")

print("hosts backup:", backup)
print("installed:", new_ip, host)
PY
}


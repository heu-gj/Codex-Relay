        ts=(updated_ms/1000) if updated_ms else updated
        dt=datetime.fromtimestamp(ts,timezone.utc).isoformat().replace("+00:00","Z")
        f.write(json.dumps({"id":sid,"thread_name":name,"updated_at":dt},ensure_ascii=False)+"\n")

tmp.replace(idx)
print("Rebuilt session index:",len(rows))
PY

    cmd_health
}


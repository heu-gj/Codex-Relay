# 网络 / 无 VPN 直连
# -----------------------------
url_host() {
    python3 - "$1" <<'PY'
import sys
from urllib.parse import urlparse
u=urlparse(sys.argv[1])
if not u.hostname:
    raise SystemExit(1)
print(u.hostname)
PY
}

url_port() {
    python3 - "$1" <<'PY'
import sys
from urllib.parse import urlparse
u=urlparse(sys.argv[1])
print(u.port or (443 if u.scheme == "https" else 80))
PY
}

direct_curl() {
    local url="$1"
    clean_proxy_env

    local code
    code="$(
        curl --noproxy '*' -4 -sS \
            -o /dev/null \
            -w '%{http_code}' \
            --connect-timeout 7 \
            --max-time 15 \
            "$url" 2>/dev/null
    )" || return 1

    [[ -n "$code" && "$code" != "000" ]] || return 1
    echo "$code"
}

resolved_curl() {
    local url="$1" host="$2" port="$3" ip="$4"
    clean_proxy_env

    local code
    code="$(
        curl --noproxy '*' -4 -sS \
            -o /dev/null \
            -w '%{http_code}' \
            --resolve "${host}:${port}:${ip}" \
            --connect-timeout 7 \
            --max-time 15 \
            "$url" 2>/dev/null
    )" || return 1

    [[ -n "$code" && "$code" != "000" ]] || return 1
    echo "$code"
}

tcp_dns_ips() {
    local host="$1" dns out
    need dig

    for dns in 8.8.8.8 1.1.1.1; do
        out="$(
            timeout 10 dig +tcp +time=4 +tries=1 \
                @"$dns" "$host" A +short 2>/dev/null || true
        )"

        out="$(printf '%s\n' "$out" | awk '
            /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/ {
                if (!seen[$0]++) print
            }
        ')"

        if [[ -n "$out" ]]; then
            printf '%s\n' "$out"
            return 0
        fi
    done

    return 1
}

install_hosts_entry() {
    local host="$1" ip="$2"

    sudo python3 - "$host" "$ip" "$HOSTS_TAG" <<'PY'
import shutil
import sys
import time
from pathlib import Path

host, new_ip, tag = sys.argv[1:]
p = Path("/etc/hosts")
backup = Path(f"/etc/hosts.codex-relay-backup-{time.strftime('%Y%m%d-%H%M%S')}")
shutil.copy2(p, backup)

out=[]
for line in p.read_text(errors="replace").splitlines():
    stripped=line.strip()
    if not stripped or stripped.startswith("#"):
        out.append(line)
        continue

    body, sep, comment = line.partition("#")
    parts=body.split()
    if len(parts) < 2:
        out.append(line)
        continue

    old_ip=parts[0]
    names=parts[1:]
    if host not in names:
        out.append(line)
        continue

    names=[n for n in names if n != host]
    if names:
        newline=old_ip + "\t" + " ".join(names)
        if sep and comment.strip():
            newline += "\t# " + comment.strip()
        out.append(newline)

out.append(f"{new_ip}\t{host}\t# {tag}")
p.write_text("\n".join(out) + "\n")

print("hosts backup:", backup)
print("installed:", new_ip, host)
PY
}

diagnostic_row() {
    local kind="$1" label="$2" value="$3"
    case "$kind" in
        ok)
            printf '  %s[✓]%s %-18s %s\n' "$UI_GREEN" "$UI_RESET" "$label" "$value"
            ;;
        warn)
            printf '  %s[!]%s %-18s %s\n' "$UI_YELLOW" "$UI_RESET" "$label" "$value"
            ;;
        fail)
            printf '  %s[✕]%s %-18s %s\n' "$UI_RED" "$UI_RESET" "$label" "$value"
            ;;
        *)
            printf '  %s[·]%s %-18s %s\n' "$UI_GRAY" "$UI_RESET" "$label" "$value"
            ;;
    esac
}

cmd_check() {
    local name="${1:-$(current_profile)}"
    load_profile "$name"
    need curl

    local host system_ip tcp_ip https_result code sec ms
    local dns_ok=0 tcp_dns_ok=0 https_ok=0
    host="$(provider_host "$P_URL")"

    clear || true
    ui_header "$(L '网络诊断' 'NETWORK DIAGNOSTICS')"

    ui_section "$(L '路由' 'ROUTE')"
    ui_kv "profile" "$name"
    ui_kv "provider" "$P_PROVIDER"
    ui_kv "model" "$P_MODEL"
    ui_kv "endpoint" "$host"

    ui_section "$(L '检查结果' 'CHECKS')"

    if proxy_env_detected; then
        diagnostic_row warn "$(L 'Shell Proxy' 'Shell Proxy')" "$(L 'DETECTED · Codex 启动时会绕过' 'DETECTED · bypassed on Codex launch')"
    else
        diagnostic_row ok "$(L 'Shell Proxy' 'Shell Proxy')" "CLEAN"
    fi

    system_ip="$(timeout 4 getent ahostsv4 "$host" 2>/dev/null | awk 'NR==1 {print $1}' || true)"
    if [[ -n "$system_ip" ]]; then
        dns_ok=1
        diagnostic_row ok "$(L 'System DNS' 'System DNS')" "$system_ip"
    else
        diagnostic_row fail "$(L 'System DNS' 'System DNS')" "$(L '无 IPv4 响应' 'no IPv4 response')"
    fi

    if command -v dig >/dev/null 2>&1; then
        tcp_ip="$(timeout 6 dig +tcp +time=3 +tries=1 @8.8.8.8 "$host" A +short 2>/dev/null | awk '/^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/ {print; exit}' || true)"
        if [[ -n "$tcp_ip" ]]; then
            tcp_dns_ok=1
            diagnostic_row ok "$(L 'TCP DNS' 'TCP DNS')" "$tcp_ip"
        else
            diagnostic_row fail "$(L 'TCP DNS' 'TCP DNS')" "$(L '查询失败' 'query failed')"
        fi
    else
        diagnostic_row warn "$(L 'TCP DNS' 'TCP DNS')" "$(L '未安装 dig' 'dig not installed')"
    fi

    https_result="$(env -u http_proxy -u https_proxy -u HTTP_PROXY -u HTTPS_PROXY -u all_proxy -u ALL_PROXY \
        curl --noproxy '*' -sS -o /dev/null -w '%{http_code} %{time_total}' \
        --connect-timeout 5 --max-time 12 "$P_URL" 2>/dev/null || true)"

    code="${https_result%% *}"
    sec="${https_result#* }"
    if [[ -n "$https_result" && "$code" != "000" ]]; then
        https_ok=1
        ms="$(awk -v t="$sec" 'BEGIN{printf "%.0f",t*1000}')"
        diagnostic_row ok "$(L 'Direct HTTPS' 'Direct HTTPS')" "HTTP $code · ${ms} ms"
        printf '✓ Direct · %s ms\n' "$ms" > "$CACHE_DIR/network-$name.txt"
    else
        diagnostic_row fail "$(L 'Direct HTTPS' 'Direct HTTPS')" "$(L '连接失败' 'connection failed')"
        printf '✕ Unreachable\n' > "$CACHE_DIR/network-$name.txt"
    fi

    ui_section "$(L '结论' 'STATUS')"
    if (( https_ok )); then
        printf '  %s%s✓ NETWORK READY%s\n' "$UI_BOLD" "$UI_GREEN" "$UI_RESET"
        if (( ! dns_ok && tcp_dns_ok )); then
            ui_warn "$(L '系统 DNS 异常，但 TCP DNS 正常；可运行 cr direct 修复直连解析。' 'System DNS failed while TCP DNS works; run cr direct to repair direct resolution.')"
        fi
        return 0
    fi

    printf '  %s%s✕ NETWORK CHECK REQUIRED%s\n' "$UI_BOLD" "$UI_RED" "$UI_RESET"
    if (( tcp_dns_ok )); then
        ui_info "$(L "TCP DNS 能解析 $host，可尝试: cr direct $name" "TCP DNS resolves $host; try: cr direct $name")"
    elif (( dns_ok )); then
        ui_info "$(L 'DNS 有响应但 HTTPS 失败，请检查 TLS、出口网络或服务端状态。' 'DNS works but HTTPS failed; inspect TLS, egress networking, or provider status.')"
    else
        ui_info "$(L 'DNS 与 HTTPS 都失败，请先检查服务器网络或 DNS。' 'Both DNS and HTTPS failed; check server networking or DNS first.')"
    fi
    return 1
}

cmd_direct() {
    local name="${1:-$(current_profile)}"
    load_profile "$name"
    need curl
    need python3

    ui_header "DIRECT CONNECT"
    ui_kv "profile" "$name"
    ui_kv "endpoint" "$P_URL"

    local code
    ui_step "1/4  测试当前无代理直连"
    if code="$(direct_curl "$P_URL")"; then
        ui_ok "已经可以直接访问 · HTTP $code"
        ui_info "无需修改 /etc/hosts"
        return 0
    fi
    ui_warn "普通直连失败"

    if [[ "$P_KIND" == "official" ]]; then
        ui_fail "官方 OpenAI 当前无法直连"
        ui_info "为避免固定官方/CDN IP，不会给官方 OpenAI 写 /etc/hosts"
        return 1
    fi

    need dig

    local host port ips ip working_ip="" rcode
    host="$(url_host "$P_URL")"
    port="$(url_port "$P_URL")"

    ui_step "2/4  使用 TCP DNS 获取候选 IPv4"
    ips="$(tcp_dns_ips "$host" || true)"
    [[ -n "$ips" ]] || die "TCP DNS 也无法解析 $host"
    while read -r ip; do
        [[ -n "$ip" ]] && printf '      %s•%s %s\n' "$UI_CYAN" "$UI_RESET" "$ip"
    done <<< "$ips"

    ui_step "3/4  逐个验证 TLS / HTTPS"
    while read -r ip; do
        [[ -n "$ip" ]] || continue
        printf '      testing %-15s ' "$ip"
        if rcode="$(resolved_curl "$P_URL" "$host" "$port" "$ip")"; then
            printf '%sOK%s  HTTP %s\n' "$UI_GREEN" "$UI_RESET" "$rcode"
            working_ip="$ip"
            break
        fi
        printf '%sFAIL%s\n' "$UI_RED" "$UI_RESET"
    done <<< "$ips"

    [[ -n "$working_ip" ]] || die "TCP DNS 有地址，但 HTTPS 验证全部失败"

    ui_step "4/4  安装经过验证的 hosts 映射"
    install_hosts_entry "$host" "$working_ip"

    if code="$(direct_curl "$P_URL")"; then
        ui_ok "直连配置完成 · HTTP $code"
        ui_kv "host" "$host"
        ui_kv "IPv4" "$working_ip"
    else
        die "写入 hosts 后仍然无法访问"
    fi
}


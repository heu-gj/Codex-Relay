cmd_run() {
    local name
    name="$(current_profile)"
    load_profile "$name"

    need codex
    need python3

    local host no_proxy relay_key=""
    host="$(url_host "$P_URL")"
    no_proxy="127.0.0.1,localhost,::1,$host"

    if [[ "$P_AUTH" == "relay" ]]; then
        ensure_relay_key "$name"
        relay_key="$(read_relay_key "$name")"
    fi

    ui_header "$(L '启动' 'LAUNCH')"
    ui_ok "$(L '正在启动 Codex' 'Launching Codex')"
    ui_kv "profile" "$name"
    ui_kv "provider" "$P_PROVIDER"
    ui_kv "model" "$P_MODEL"
    if [[ "$P_AUTH" == "relay" ]]; then
        ui_kv "api key" "$(L '已加载（当前用户）' 'loaded (current user)')"
    fi
    ui_kv "proxy" "disabled"
    ui_kv "NO_PROXY" "$no_proxy"
    printf '\n'

    if [[ "$P_AUTH" == "relay" ]]; then
        exec env \
            -u http_proxy \
            -u https_proxy \
            -u HTTP_PROXY \
            -u HTTPS_PROXY \
            -u all_proxy \
            -u ALL_PROXY \
            NO_PROXY="$no_proxy" \
            no_proxy="$no_proxy" \
            CODEX_RELAY_API_KEY="$relay_key" \
            codex "$@"
    else
        exec env \
            -u http_proxy \
            -u https_proxy \
            -u HTTP_PROXY \
            -u HTTPS_PROXY \
            -u all_proxy \
            -u ALL_PROXY \
            NO_PROXY="$no_proxy" \
            no_proxy="$no_proxy" \
            codex "$@"
    fi
}


        if profile_exists "$name"; then
            existing=1
            ui_warn "$(L "当前用户已经存在名为 $name 的中转站；继续会覆盖它的基础定义，但不会自动删除已保存的 Key。" "A provider named $name already exists for this user; continuing replaces its base definition but does not automatically delete its saved key.")"
            printf '%s' "$(L '输入 OVERWRITE 或“覆盖”继续，其他输入取消: ' 'Type OVERWRITE or replace to continue; anything else cancels: ')"
            IFS= read -r confirm
            case "$confirm" in
                OVERWRITE|overwrite|覆盖|replace|REPLACE) ;;
                *) ui_info "$(L '已取消添加中转站。' 'Provider creation cancelled.')"; return ;;
            esac
        fi
        break
    done

    while true; do
        ui_section "$(L '步骤 2/4 · API 地址' 'STEP 2/4 · API ENDPOINT')"
        printf '  %s\n' "$(L '填写服务商提供的 OpenAI 兼容 Base URL。必须以 http:// 或 https:// 开头。' 'Enter the OpenAI-compatible Base URL supplied by the provider. It must start with http:// or https://.')"
        printf '  %s\n' "$(L '是否需要 /v1 必须以服务商文档为准，不要自行补全。' 'Whether /v1 is required depends on the provider documentation; do not add it automatically.')"
        printf '  %s\n' "$(L '示例: https://api.example.com/v1   或   https://gateway.example.com' 'Examples: https://api.example.com/v1   or   https://gateway.example.com')"
        printf '  %s\n' "$(L '公网中转建议使用 HTTPS；HTTP 只适合你明确知道的内网/本机服务。输入 0 可取消。' 'Use HTTPS for public relays; HTTP is appropriate only for trusted local/private services. Enter 0 to cancel.')"
        printf '\n%s' "$(L 'Base URL: ' 'Base URL: ')"
        IFS= read -r url

        [[ "$url" == "0" ]] && { ui_info "$(L '已取消添加中转站。' 'Provider creation cancelled.')"; return; }
        if [[ ! "$url" =~ ^https?:// ]]; then
            ui_warn "$(L '地址必须以 http:// 或 https:// 开头。' 'The URL must start with http:// or https://.')"
            continue
        fi
        break
    done

    while true; do
        ui_section "$(L '步骤 3/4 · 默认模型' 'STEP 3/4 · DEFAULT MODEL')"
        printf '  %s\n' "$(L '填写服务商实际支持的模型 ID；Codex 会把这个值原样发送给中转站。' 'Enter a model ID actually supported by the provider; Codex sends this value to the relay as-is.')"
        printf '  %s\n' "$(L '示例: gpt-5.5、gpt-5.6-sol。具体可用名称以服务商控制台/文档为准。' 'Examples: gpt-5.5, gpt-5.6-sol. Use the exact model name documented by your provider.')"
        printf '  %s\n' "$(L '模型填错通常会在启动后返回 model_not_found / unsupported_model，而不是网络错误。输入 0 可取消。' 'An invalid model usually causes model_not_found / unsupported_model after launch, not a network error. Enter 0 to cancel.')"
        printf '\n%s' "$(L '默认模型: ' 'Default model: ')"
        IFS= read -r model

        [[ "$model" == "0" ]] && { ui_info "$(L '已取消添加中转站。' 'Provider creation cancelled.')"; return; }
        if [[ -z "$model" ]]; then
            ui_warn "$(L '默认模型不能为空。' 'Default model cannot be empty.')"
            continue
        fi
        break
    done

    while true; do
        ui_section "$(L '步骤 4/4 · Provider ID' 'STEP 4/4 · PROVIDER ID')"
        printf '  %s\n' "$(L '这是写入 ~/.codex/config.toml 中 [model_providers.<ID>] 的标识符。' 'This becomes the identifier in ~/.codex/config.toml under [model_providers.<ID>].')"
        printf '  %s\n' "$(L "如果服务商没有明确要求特殊 ID，直接按 Enter 使用 \"$name\" 即可。" "If the provider does not require a special ID, press Enter to use \"$name\".")"
        printf '  %s\n' "$(L '它不是 API Key，也不是模型名。允许字母、数字、下划线、短横线。' 'This is not the API key or model name. Letters, numbers, underscore, and hyphen are allowed.')"
        printf '\n%s' "Provider ID [$name]: "
        IFS= read -r provider
        provider="${provider:-$name}"

        if [[ ! "$provider" =~ ^[A-Za-z0-9_-]+$ ]]; then
            ui_warn "$(L 'Provider ID 格式非法。' 'Invalid Provider ID.')"
            continue
        fi
        break
    done

    clear || true
    ui_header "$(L '确认中转站配置' 'REVIEW PROVIDER')"
    ui_section "$(L '即将保存' 'CONFIGURATION')"
    ui_kv "$(L '名称' 'name')" "$name"
    ui_kv "Provider ID" "$provider"
    ui_kv "$(L '默认模型' 'model')" "$model"
    ui_kv "Base URL" "$url"
    ui_kv "$(L '认证方式' 'auth')" "$(L '当前用户独立 API Key · Codex 原生 auth.json' 'per-user API key · native Codex auth.json')"
    [[ "$existing" == "1" ]] && ui_warn "$(L '这是覆盖现有自定义中转站的操作。' 'This will replace an existing custom provider definition.')"

    printf '\n%s' "$(L '确认保存？输入 YES 或“确认”；其他输入取消: ' 'Save this provider? Type YES or confirm; anything else cancels: ')"
    IFS= read -r confirm
    case "$confirm" in
        YES|yes|Yes|确认|confirm|CONFIRM) ;;
        *) ui_info "$(L '已取消，没有写入配置。' 'Cancelled; no configuration was written.')"; return ;;
    esac

    cmd_add "$name" "$url" "$model" "$provider" relay

    printf '\n'
    ui_ok "$(L "已创建中转站: $name" "Provider created: $name")"
    ui_info "$(L 'API Key 会单独保存在当前用户 ~/.codex-relay/secrets/，不会写入 config.toml。' 'The API key is stored separately under the current user’s ~/.codex-relay/secrets/ and is not written to config.toml.')"

    printf '\n%s' "$(L '现在设置 API Key？[Y/n]: ' 'Set the API key now? [Y/n]: ')"
    IFS= read -r yn
    case "$yn" in
        n|N)
            ui_info "$(L "稍后可执行: cr key set $name" "You can set it later with: cr key set $name")"
            ;;
        *)
            cmd_key set "$name"
            ;;
    esac

    printf '\n'
    ui_section "$(L '下一步' 'NEXT STEPS')"
    printf '  %s\n' "$(L "查看网络:      cr check $name" "Check network:   cr check $name")"
    printf '  %s\n' "$(L "仅切换配置:    cr use $name" "Use config only: cr use $name")"
    printf '  %s\n' "$(L "切换并启动:    cr switch $name" "Switch & launch: cr switch $name")"
    printf '  %s\n' "$(L "进入详情页:    cr → 选择 $name" "Open details:    cr → select $name")"
}

provider_cached_network() {
    local name="$1" file value=""
    file="$CACHE_DIR/network-$name.txt"
    if [[ -s "$file" ]]; then
        IFS= read -r value < "$file" || true
        printf '%s' "${value:-?}"
    else
        printf '%s' "$(L '未检测' 'not checked')"
    fi
}

provider_host() {
    local url="$1" host
    host="${url#*://}"
    host="${host%%/*}"
    host="${host##*@}"
    printf '%s' "$host"
}

provider_key_badge() {
    local name="$1"
    load_profile "$name"
    if [[ "$P_AUTH" == "relay" ]]; then
        if relay_key_exists "$name"; then
            printf '%s✓ KEY%s' "$UI_GREEN" "$UI_RESET"
        else
            printf '%s✕ KEY%s' "$UI_RED" "$UI_RESET"
        fi
    else
        printf '%sCODEX AUTH%s' "$UI_CYAN" "$UI_RESET"
    fi
}

provider_type_badge() {
    local name="$1"
    case "$name" in
        nova|baibai) printf '%sBUILT-IN%s' "$UI_PURPLE" "$UI_RESET" ;;
        official) printf '%sOFFICIAL%s' "$UI_CYAN" "$UI_RESET" ;;
        *) printf '%sCUSTOM%s' "$UI_YELLOW" "$UI_RESET" ;;
    esac
}

provider_card() {
    local idx="$1" name="$2" active="$3"
    local title status host network key_badge type_badge model_line

    load_profile "$name"
    title="${name^^}"
    host="$(provider_host "$P_URL")"
    network="$(provider_cached_network "$name")"
    key_badge="$(provider_key_badge "$name")"
    type_badge="$(provider_type_badge "$name")"
    model_line="$P_MODEL"
    [[ -n "$P_REASONING" ]] && model_line="$model_line · $P_REASONING"

    if [[ "$name" == "$active" ]]; then
        status="${UI_GREEN}● ACTIVE${UI_RESET}"
    else
        status="${UI_DIM}○ STANDBY${UI_RESET}"
    fi

    printf '\n  %s[%s]%s  %s%s%s  %b  %b\n' \
        "$UI_CYAN" "$idx" "$UI_RESET" \
        "$UI_BOLD$UI_WHITE" "$title" "$UI_RESET" \
        "$status" "$type_badge"
    printf '       %s├─ model%s    %s\n' "$UI_DIM" "$UI_RESET" "$model_line"
    printf '       %s└─ route%s    %s  %b  %sNET%s %s\n' \
        "$UI_DIM" "$UI_RESET" "$host" "$key_badge" \
        "$UI_BLUE" "$UI_RESET" "$network"
}

provider_model_urls() {
    local name="$1" base
    load_profile "$name"
    base="${P_URL%/}"

    printf '%s/models\n' "$base"
    case "$base" in
        */v1) ;;
        *) printf '%s/v1/models\n' "$base" ;;
    esac
}

fetch_provider_models() {
    local name="$1" key header_file body_file url code parsed
    load_profile "$name"

    [[ "$P_AUTH" == "relay" ]] || return 2
    relay_key_exists "$name" || return 3
    command -v curl >/dev/null 2>&1 || return 4
    command -v python3 >/dev/null 2>&1 || return 4

    key="$(read_relay_key "$name")"
    header_file="$(mktemp "$RELAY_DIR/.models-header.XXXXXX")"
    body_file="$(mktemp "$RELAY_DIR/.models-body.XXXXXX")"
    chmod 600 "$header_file" "$body_file"
    printf 'Authorization: Bearer %s\n' "$key" > "$header_file"

    while IFS= read -r url; do
        [[ -n "$url" ]] || continue
        : > "$body_file"

        code="$(env -u http_proxy -u https_proxy -u HTTP_PROXY -u HTTPS_PROXY -u all_proxy -u ALL_PROXY \
            curl --noproxy '*' -sS \
            --connect-timeout 5 --max-time 12 \
            -H "@$header_file" \
            -H 'Accept: application/json' \
            -o "$body_file" -w '%{http_code}' \
            "$url" 2>/dev/null || true)"

        [[ "$code" =~ ^2[0-9][0-9]$ ]] || continue

        parsed="$(python3 - "$body_file" <<'PY'
import json
import sys
from pathlib import Path

try:
    obj = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8", errors="replace"))
except Exception:
    raise SystemExit(0)

if isinstance(obj, dict):
    if isinstance(obj.get("data"), list):
        items = obj["data"]
    elif isinstance(obj.get("models"), list):
        items = obj["models"]
    else:
        items = []
elif isinstance(obj, list):
    items = obj
else:
    items = []

seen = set()
models = []
for item in items:
    if isinstance(item, str):
        mid = item
    elif isinstance(item, dict):
        mid = item.get("id") or item.get("model") or item.get("name")
    else:
        mid = None
    if not isinstance(mid, str):
        continue
    mid = mid.strip()
    if not mid or mid in seen:
        continue
    seen.add(mid)
    models.append(mid)

for mid in sorted(models, key=str.lower):
    print(mid)
PY
)"

        if [[ -n "$parsed" ]]; then
            rm -f "$header_file" "$body_file"
            printf '%s\n' "$parsed"
            return 0
        fi
    done < <(provider_model_urls "$name")

    rm -f "$header_file" "$body_file"
    return 1
}

cmd_reasoning_picker() {
    local name="$1" new_model="$2" choice manual current_reasoning

    load_profile "$name"
    current_reasoning="$P_REASONING"
    SELECTED_REASONING=""

    while true; do
        clear || true
        ui_header "REASONING // ${name^^}"

        ui_section "$(L '即将应用' 'PENDING MODEL')"
        ui_kv "$(L '模型' 'model')" "$new_model"
        if [[ -n "$current_reasoning" ]]; then
            ui_kv "$(L '当前推理强度' 'current reasoning')" "$current_reasoning"
        else
            ui_kv "$(L '当前推理强度' 'current reasoning')" "$(L 'Auto / 未指定' 'Auto / unset')"
        fi

        ui_section "$(L '推理强度' 'REASONING EFFORT')"
        ui_menu_item "Enter" "Auto" "$(L '推荐 · 不写 model_reasoning_effort' 'recommended · leave model_reasoning_effort unset')"
        if [[ -n "$current_reasoning" ]]; then
            ui_menu_item "K" "$(L '保持当前' 'Keep current')" "$current_reasoning"
        else
            ui_menu_item "K" "$(L '保持当前' 'Keep current')" "$(L 'Auto / 未指定' 'Auto / unset')"
        fi
        ui_menu_item "N" "None" "$(L '仅模型支持时使用' 'use only when supported by the model')"
        ui_menu_item "1" "Minimal" ""
        ui_menu_item "2" "Low" "$(L '更快 / 较少推理' 'faster / less reasoning')"
        ui_menu_item "3" "Medium" "$(L '速度与推理平衡' 'balanced')"
        ui_menu_item "4" "High" "$(L '更多推理' 'more reasoning')"
        ui_menu_item "5" "XHigh" "$(L '最强 / 通常更慢' 'deepest / usually slower')"
        ui_menu_item "M" "$(L '手动填写' 'Manual value')" "$(L '服务商自定义 effort' 'provider-specific effort')"
        ui_menu_item "0" "$(L '取消，不修改模型' 'Cancel without changing model')" ""

        printf '\n'
        ui_info "$(L '不同模型支持的 effort 不完全一致；Auto 对未知/自定义模型最安全。' 'Supported effort values vary by model; Auto is safest for unknown/custom models.')"
        printf '\n%s›%s ' "$UI_PINK" "$UI_RESET"
        IFS= read -r choice

        case "$choice" in
            ""|a|A)
                SELECTED_REASONING="auto"
                return 0
                ;;
            k|K)
                SELECTED_REASONING="keep"
                return 0
                ;;
            n|N)
                SELECTED_REASONING="none"
                return 0
                ;;
            1)
                SELECTED_REASONING="minimal"
                return 0
                ;;
            2)
                SELECTED_REASONING="low"
                return 0
                ;;
            3)
                SELECTED_REASONING="medium"
                return 0
                ;;
            4)
                SELECTED_REASONING="high"
                return 0
                ;;
            5)
                SELECTED_REASONING="xhigh"
                return 0
                ;;
            m|M)
                printf '%s' "$(L '自定义 reasoning effort: ' 'Custom reasoning effort: ')"
                IFS= read -r manual
                [[ -n "$manual" ]] || {
                    ui_warn "$(L '不能为空' 'Value cannot be empty')"
                    sleep 0.5
                    continue
                }
                [[ "$manual" =~ ^[A-Za-z0-9._-]+$ ]] || {
                    ui_warn "$(L '格式非法，只能使用字母、数字、点、下划线和短横线' 'Invalid format; use letters, numbers, dot, underscore, or hyphen')"
                    sleep 0.7
                    continue
                }
                SELECTED_REASONING="${manual,,}"
                return 0
                ;;
            0|q|Q)
                return 1
                ;;
            *)
                ui_warn "$(L '无效选择' 'Invalid choice')"
                sleep 0.5
                ;;
        esac
    done
}

apply_model_from_picker() {
    local name="$1" model="$2"
    if cmd_reasoning_picker "$name" "$model"; then
        cmd_model "$name" "$model" "$SELECTED_REASONING"
        return 0
    fi
    ui_info "$(L '已取消，模型和推理强度都没有修改。' 'Cancelled; model and reasoning effort were not changed.')"
    return 1
}

cmd_model_picker() {
    local name="$1" choice current value i
    local -a models=()

    while true; do
        load_profile "$name"
        current="$P_MODEL"

        clear || true
        ui_header "MODEL // ${name^^}"
        ui_kv "$(L '当前模型' 'current model')" "$current"
        if [[ -n "$P_REASONING" ]]; then
            ui_kv "$(L '当前推理强度' 'current reasoning')" "$P_REASONING"
        else
            ui_kv "$(L '当前推理强度' 'current reasoning')" "$(L 'Auto / 未指定' 'Auto / unset')"
        fi
        ui_kv "endpoint" "$(provider_host "$P_URL")"
        printf '\n'

        if [[ "$P_AUTH" != "relay" ]]; then
            ui_warn "$(L '该 profile 不能通过 Relay API Key 自动读取模型列表，请手动输入模型 ID。' 'This profile cannot discover models through a relay API key; enter the model ID manually.')"
            printf '\n%s [%s]: ' "$(L '模型 ID' 'Model ID')" "$current"
            IFS= read -r value
            [[ -n "$value" ]] && cmd_model "$name" "$value"
            ui_pause
            return
        fi

        if ! relay_key_exists "$name"; then
            ui_warn "$(L '读取模型列表需要当前用户这个中转站自己的 API Key。' 'Reading the model list requires this user’s API key for the provider.')"
            ui_menu_item "K" "$(L '设置 API Key 后重试' 'Set API key and retry')" ""
            ui_menu_item "M" "$(L '手动输入模型 ID' 'Enter model ID manually')" ""
            ui_menu_item "0" "$(L '返回' 'Back')" ""
            printf '\n%s›%s ' "$UI_PINK" "$UI_RESET"
            read -r choice
            case "$choice" in
                k|K)
                    cmd_key set "$name"
                    ui_pause
                    ;;
                m|M)
                    printf '%s [%s]: ' "$(L '模型 ID' 'Model ID')" "$current"
                    IFS= read -r value
                    if [[ -n "$value" ]]; then
                        apply_model_from_picker "$name" "$value" || true
                    fi
                    ui_pause
                    return
                    ;;
                0|q|Q)
                    return
                    ;;
                *)
                    ui_warn "$(L '无效选择' 'Invalid choice')"
                    sleep 0.5
                    ;;
            esac
            continue
        fi

        ui_step "$(L '正在读取中转站可用模型…' 'Reading available models from provider…')"
        models=()
        mapfile -t models < <(fetch_provider_models "$name" || true)

        if (( ${#models[@]} == 0 )); then
            ui_warn "$(L '没有从 /models 或 /v1/models 读取到模型列表；服务商可能没有提供模型枚举接口。' 'No model list was returned from /models or /v1/models; the provider may not expose model discovery.')"
            ui_menu_item "R" "$(L '重新读取' 'Retry')" ""
            ui_menu_item "M" "$(L '手动输入模型 ID' 'Enter model ID manually')" ""
            ui_menu_item "0" "$(L '返回' 'Back')" ""
            printf '\n%s›%s ' "$UI_PINK" "$UI_RESET"
            read -r choice
            case "$choice" in
                r|R)
                    continue
                    ;;
                m|M)
                    printf '%s [%s]: ' "$(L '模型 ID' 'Model ID')" "$current"
                    IFS= read -r value
                    if [[ -n "$value" ]]; then
                        apply_model_from_picker "$name" "$value" || true
                    fi
                    ui_pause
                    return
                    ;;
                0|q|Q)
                    return
                    ;;
                *)
                    ui_warn "$(L '无效选择' 'Invalid choice')"
                    sleep 0.5
                    ;;
            esac
            continue
        fi

        ui_section "$(L '可用模型' 'AVAILABLE MODELS')"
        i=1
        for value in "${models[@]}"; do
            if [[ "$value" == "$current" ]]; then
                ui_menu_item "$i" "$value" "$(L '● 当前' '● CURRENT')"
            else
                ui_menu_item "$i" "$value" ""
            fi
            i=$((i+1))
            (( i > 60 )) && break
        done

        if (( ${#models[@]} > 60 )); then
            ui_info "$(L '模型超过 60 个，当前显示前 60 个；也可以使用手动输入。' 'More than 60 models were returned; showing the first 60. Manual entry is also available.')"
        fi

        printf '\n'
        ui_menu_item "R" "$(L '重新读取模型列表' 'Refresh model list')" ""
        ui_menu_item "M" "$(L '手动输入模型 ID' 'Enter model ID manually')" ""
        ui_menu_item "0" "$(L '返回' 'Back')" ""
        printf '\n%s›%s ' "$UI_PINK" "$UI_RESET"
        read -r choice

        case "$choice" in
            r|R)
                continue
                ;;
            m|M)
                printf '%s [%s]: ' "$(L '模型 ID' 'Model ID')" "$current"
                IFS= read -r value
                if [[ -n "$value" ]]; then
                    apply_model_from_picker "$name" "$value" || true
                fi
                ui_pause
                return
                ;;
            0|q|Q)
                return
                ;;
            *)
                if [[ "$choice" =~ ^[0-9]+$ ]] && (( choice >= 1 && choice <= ${#models[@]} && choice <= 60 )); then
                    value="${models[$((choice-1))]}"
                    apply_model_from_picker "$name" "$value" || true
                    ui_pause
                    return
                fi
                ui_warn "$(L '无效选择' 'Invalid choice')"
                sleep 0.5
                ;;
        esac
    done
}


    if env | grep -iE '^(http|https|all|no)_proxy='; then
        :
    else
        ui_ok "没有检测到代理环境变量"
    fi

    ui_section "System resolver"
    if timeout 6 getent ahostsv4 "$host"; then
        ui_ok "系统 resolver 有响应"
    else
        ui_warn "系统 resolver 未能及时返回 IPv4 地址"
    fi

    ui_section "TCP DNS / 8.8.8.8"
    if command -v dig >/dev/null 2>&1; then
        if dig +tcp +time=4 +tries=1 @8.8.8.8 "$host" A +short; then
            :
        else
            ui_warn "TCP DNS 查询失败"
        fi
    else
        ui_warn "未安装 dig；可执行 sudo apt install dnsutils"
    fi

    ui_section "Direct HTTPS / no proxy"
    if code="$(direct_curl "$P_URL")"; then
        ui_ok "直连成功 · HTTP $code"
        return 0
    fi

    ui_fail "当前无法直接访问 $host"

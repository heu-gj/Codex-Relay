cmd_add() {
    [[ $# -ge 3 && $# -le 5 ]] || {
        echo "用法:"
        echo "  cr add NAME BASE_URL MODEL [PROVIDER_ID] [AUTH]"
        echo
        echo "AUTH: relay | openai | env:变量名 | none"
        exit 1
    }

    local name="$1" url="$2" model="$3"
    local provider="${4:-$name}"
    local auth="${5:-relay}"

    [[ "$name" =~ ^[A-Za-z0-9_-]+$ ]] || die "NAME 格式非法"
    [[ "$provider" =~ ^[A-Za-z0-9_-]+$ ]] || die "PROVIDER_ID 格式非法"
    [[ "$url" =~ ^https?:// ]] || die "BASE_URL 必须以 http:// 或 https:// 开头"

    case "$auth" in
        relay|openai|none|env:*) ;;
        *) die "AUTH 必须是 relay / openai / env:变量名 / none" ;;
    esac

    local tmp
    tmp="$(mktemp)"
    awk -F '\t' -v n="$name" '$1 != n' "$REGISTRY" > "$tmp"
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
        "$name" "$provider" "$url" "$model" "$auth" "-" "-" "false" >> "$tmp"
    mv "$tmp" "$REGISTRY"

    echo "已添加: $name"
    echo "  provider: $provider"
    echo "  url     : $url"
    echo "  model   : $model"
}


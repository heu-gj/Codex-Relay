refresh_dashboard_cli() {
    local file="$CACHE_DIR/cli-version.txt" out
    if ! command -v codex >/dev/null 2>&1; then
        printf '%s\n' "N/A" > "$file"
        return
    fi

    out="$(codex --version 2>/dev/null || true)"
    printf '%s\n' "$out" | grep -Eo '[0-9]+\.[0-9]+\.[0-9]+' | head -n1 > "$file"
    [[ -s "$file" ]] || printf '%s\n' "?" > "$file"
}

dashboard_process_count() {
    ps -u "$(id -u)" -o comm= 2>/dev/null | awk '
        /^codex$/ {n++; next}
        /^codex-/ && $0 !~ /^codex-relay/ {n++}
        END {print n+0}
    '
}

dashboard_url_host() {
    local url="$1" host
    host="${url#*://}"
    host="${host%%/*}"
    host="${host##*@}"
    printf '%s' "$host"
}

dashboard_daemon_version() {
    local file="$CACHE_DIR/daemon-version.txt"
    if [[ -s "$file" ]]; then
        cat "$file"
    else
        printf '%s' "$(L '未检测 · 按 R' 'not checked · press R')"
    fi
}

refresh_dashboard_daemon() {
    local file="$CACHE_DIR/daemon-version.txt" out
    if ! command -v codex >/dev/null 2>&1; then
        printf '%s\n' "N/A" > "$file"
        return 0
    fi

    out="$(timeout 2 codex app-server daemon version 2>/dev/null || true)"
    if [[ -z "$out" ]]; then
        printf '%s\n' "$(L '未运行/未知' 'stopped/unknown')" > "$file"
        return 0
    fi

    printf '%s\n' "$out" | grep -Eo '[0-9]+\.[0-9]+\.[0-9]+' | head -n1 > "$file"
    [[ -s "$file" ]] || printf '%s\n' "?" > "$file"
}

dashboard_network_summary() {

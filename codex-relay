cmd_repair_history_auto() {
    local mode="${1:-repair}"

    clear || true
    ui_header "$(L '修复聊天库 / 索引' 'REPAIR HISTORY DATABASE / INDEX')"

    local running confirm
    running="$(codex_process_count)"

    ui_warn "$(L '此操作会停止当前 Linux 用户的全部 Codex 服务/进程，并可能中断正在执行或排队的任务。' 'This will stop all Codex services/processes for the current Linux user and may interrupt running or queued work.')"
    ui_info "$(L '将扫描当前用户所有 provider 的 rollout，并修复 SQLite / session_index 的缺失或损坏记录。' 'All provider rollouts for the current user will be scanned to repair missing or damaged SQLite / session_index records.')"
    if [[ "$mode" == "restore-all" ]]; then
        local restore_profile restore_provider
        restore_profile="$(current_profile)"
        load_profile "$restore_profile"
        restore_provider="$P_PROVIDER"
        ui_warn "$(L "修复完成后，会把全部本地聊天的 model_provider 统一迁移到当前中转站：$restore_profile ($restore_provider)。" "After repair, all local chats will have model_provider migrated to the active route: $restore_profile ($restore_provider).")"
        ui_info "$(L '只修改历史的 provider 元数据；消息正文、标题和工具记录不会被改写。当前 config.toml / auth.json 保持当前中转站。' 'Only provider metadata is rewritten; message bodies, titles, and tool records are untouched. The current config.toml / auth.json remain on the active route.')"
    else
        ui_warn "$(L '注意：此操作不会批量改写旧聊天的 model_provider。跨中转精确恢复请使用 [3]。' 'This operation does not bulk-rewrite old model_provider values. Use [3] for precise cross-provider recovery.')"
        ui_info "$(L "当前路由会保持为 $(current_profile)；修复聊天库不会自动迁移 provider。" "The current route remains $(current_profile); repairing the history database does not automatically migrate providers.")"
    fi
    ui_kv "$(L '检测到的 Codex 进程' 'detected Codex processes')" "$running"
    printf '\n'

    if [[ "$running" == "0" ]]; then
        ui_info "$(L '当前未检测到运行中的 Codex 进程，但脚本无法可靠判断 daemon 队列中是否仍有任务。' 'No running Codex processes were detected, but the script cannot reliably determine whether daemon work is still queued.')"
    else
        ui_warn "$(L '当前检测到 Codex 仍在运行；继续后会自动全部停止。' 'Codex is currently running; continuing will stop it automatically.')"
    fi

    printf '\n%s' "$(L '请确认当前用户没有正在执行或排队的重要任务。输入 YES 或“确认”继续: ' 'Confirm there is no important running or queued work. Type YES or confirm to continue: ')"
    IFS= read -r confirm

    case "$confirm" in
        YES|yes|Yes|确认|confirm|CONFIRM)
            ;;
        *)
            ui_info "$(L '已取消，没有停止 Codex，也没有修改聊天数据库。' 'Cancelled. Codex was not stopped and the history database was not modified.')"
            return 2
            ;;
    esac

    printf '\n'
    if [[ "$running" != "0" ]]; then
        if ! cmd_stop; then
            ui_fail "$(L 'Codex 未能完全停止，已取消历史修复。' 'Codex could not be fully stopped; history repair was cancelled.')"
            return 1
        fi
        printf '\n'
    fi

    if ! require_codex_stopped; then
        ui_fail "$(L '仍检测到 Codex 运行，已取消历史修复。' 'Codex is still running; history repair was cancelled.')"
        return 1
    fi

    cmd_repair_history
}

cmd_migrate_history_to_current_provider() {
    local profile target_provider
    profile="$(current_profile)"
    load_profile "$profile"
    target_provider="$P_PROVIDER"

    [[ -n "$target_provider" ]] || die "$(L '当前 profile 没有有效的 provider ID' 'The active profile has no valid provider ID')"
    [[ -f "$CODEX_DIR/state_5.sqlite" ]] || die "state_5.sqlite 不存在"
    require_codex_stopped || return 1
    need python3

    ui_header "$(L '迁移聊天到当前中转站' 'MIGRATE CHATS TO ACTIVE PROVIDER')"
    ui_kv "profile" "$profile"
    ui_kv "provider" "$target_provider"
    ui_kv "model" "$P_MODEL"
    ui_kv "endpoint" "$P_URL"
    printf '\n'

    python3 - "$CODEX_DIR" "$target_provider" <<'MIGRATEPY'
from pathlib import Path
from collections import Counter
import json
import os
import shutil
import sqlite3
import sys
import tempfile

home = Path(sys.argv[1]).expanduser().resolve()
target = sys.argv[2]
db = home / "state_5.sqlite"

conn = sqlite3.connect(db)
conn.row_factory = sqlite3.Row

integrity = conn.execute("PRAGMA integrity_check").fetchone()[0]
if integrity != "ok":
    conn.close()
    raise SystemExit(f"ABORT: SQLite integrity_check != ok: {integrity}")

columns = {r[1] for r in conn.execute("PRAGMA table_info(threads)")}
if "model_provider" not in columns:
    conn.close()
    raise SystemExit("threads.model_provider 不存在，无法迁移")

rows = conn.execute(
    "SELECT id, COALESCE(model_provider,'') AS model_provider FROM threads"
).fetchall()
before = Counter(str(r["model_provider"] or "") for r in rows)
db_changed = sum(1 for r in rows if str(r["model_provider"] or "") != target)

print("=== Provider migration preview ===")
print("target provider      :", target)
print("SQLite threads       :", len(rows))
if before:
    for provider, count in before.most_common():
        label = provider or "<empty>"
        action = "keep" if provider == target else f"-> {target}"
        print(f"  {label:24} {count:6}  {action}")

# Stage every rollout rewrite before touching SQLite or replacing any source file.
staged = []
rollout_files = 0
rollout_files_changed = 0
rollout_meta_changed = 0
rollout_before = Counter()

try:
    for dirname in ("sessions", "archived_sessions"):
        root = home / dirname
        if not root.exists():
            continue

        for path in root.rglob("rollout-*.jsonl"):
            rollout_files += 1
            fd, tmp_name = tempfile.mkstemp(
                prefix=".codex-relay-provider-stage-",
                suffix=".tmp",
                dir=str(path.parent),
                text=True,
            )
            changed = False
            try:
                with path.open("r", encoding="utf-8") as src, os.fdopen(
                    fd, "w", encoding="utf-8"
                ) as dst:
                    for raw in src:
                        has_newline = raw.endswith("\n")
                        body = raw[:-1] if has_newline else raw
                        try:
                            obj = json.loads(body)
                        except Exception:
                            dst.write(raw)
                            continue

                        payload = obj.get("payload")
                        if (
                            obj.get("type") == "session_meta"
                            and isinstance(payload, dict)
                            and payload.get("id")
                        ):
                            old = str(payload.get("model_provider") or "")
                            rollout_before[old] += 1
                            if old != target:
                                payload["model_provider"] = target
                                obj["payload"] = payload
                                line = json.dumps(
                                    obj, ensure_ascii=False, separators=(",", ":")
                                )
                                if has_newline:
                                    line += "\n"
                                dst.write(line)
                                changed = True
                                rollout_meta_changed += 1
                                continue

                        dst.write(raw)

                    dst.flush()
                    os.fsync(dst.fileno())

                if changed:
                    shutil.copymode(path, tmp_name)
                    staged.append((path, Path(tmp_name)))
                    rollout_files_changed += 1
                else:
                    os.unlink(tmp_name)
            except Exception:
                try:
                    os.unlink(tmp_name)
                except OSError:
                    pass
                raise

    # Keep a per-file rollback copy while the SQLite transaction is open.
    replaced = []
    backups = []
    conn.execute("BEGIN IMMEDIATE")
    try:
        conn.execute(
            "UPDATE threads SET model_provider=? WHERE COALESCE(model_provider,'')<>?",
            (target, target),
        )

        for path, staged_path in staged:
            fd, backup_name = tempfile.mkstemp(
                prefix=".codex-relay-provider-original-",
                suffix=".tmp",
                dir=str(path.parent),
            )
            os.close(fd)
            backup_path = Path(backup_name)
            shutil.copy2(path, backup_path)
            backups.append(backup_path)

            os.replace(staged_path, path)
            replaced.append((path, backup_path))

        db_mismatch = conn.execute(
            "SELECT COUNT(*) FROM threads WHERE COALESCE(model_provider,'')<>?",
            (target,),
        ).fetchone()[0]
        if db_mismatch:
            raise RuntimeError(
                f"provider verification failed in SQLite: {db_mismatch} rows differ"
            )

        rollout_mismatch = 0
        verified_session_meta = 0
        for dirname in ("sessions", "archived_sessions"):
            root = home / dirname
            if not root.exists():
                continue
            for path in root.rglob("rollout-*.jsonl"):
                with path.open("r", encoding="utf-8") as src:
                    for raw in src:
                        try:
                            obj = json.loads(raw)
                        except Exception:
                            continue
                        payload = obj.get("payload")
                        if (
                            obj.get("type") == "session_meta"
                            and isinstance(payload, dict)
                            and payload.get("id")
                        ):
                            verified_session_meta += 1
                            if str(payload.get("model_provider") or "") != target:
                                rollout_mismatch += 1

        if rollout_mismatch:
            raise RuntimeError(
                f"provider verification failed in rollout metadata: "
                f"{rollout_mismatch} session_meta records differ"
            )

        integrity_after = conn.execute("PRAGMA integrity_check").fetchone()[0]
        if integrity_after != "ok":
            raise RuntimeError(
                f"SQLite integrity_check failed after migration: {integrity_after}"
            )

        conn.commit()
    except Exception:
        conn.rollback()
        for path, backup_path in reversed(replaced):
            if backup_path.exists():
                os.replace(backup_path, path)
        raise
    finally:
        for backup_path in backups:
            try:
                backup_path.unlink()
            except FileNotFoundError:
                pass

finally:
    for _, staged_path in staged:
        try:
            staged_path.unlink()
        except FileNotFoundError:
            pass
    conn.close()

print()
print("SQLite providers changed :", db_changed)
print("rollout files scanned    :", rollout_files)
print("rollout files changed    :", rollout_files_changed)
print("session_meta changed     :", rollout_meta_changed)
print("session_meta verified    :", verified_session_meta)
print("provider parity          : OK")
print("SQLite integrity         : ok")

if rollout_before:
    print()
    print("=== Rollout provider distribution before migration ===")
    for provider, count in rollout_before.most_common():
        label = provider or "<empty>"
        action = "keep" if provider == target else f"-> {target}"
        print(f"  {label:24} {count:6}  {action}")
MIGRATEPY

    ui_ok "$(L "全部本地聊天已迁移到当前 provider: $target_provider" "All local chats were migrated to the active provider: $target_provider")"
}

cmd_restore_all_history() {
    local profile target_provider rc

    profile="$(current_profile)"
    load_profile "$profile"
    target_provider="$P_PROVIDER"

    clear || true
    ui_header "$(L '一键恢复全部聊天记录' 'RESTORE ALL CHAT HISTORY')"
    ui_info "$(L '目标：恢复当前用户全部本地聊天，并把所有历史 provider 迁移到当前中转站，使它们能在当前路由的 Codex 历史列表中出现并继续。' 'Goal: restore all local chats and migrate every historical provider to the active route so the chats appear in the current Codex history list and can be continued there.')"
    ui_kv "$(L '当前 profile' 'active profile')" "$profile"
    ui_kv "$(L '目标 provider' 'target provider')" "$target_provider"
    ui_kv "endpoint" "$P_URL"
    ui_warn "$(L '执行前会完整备份；迁移只改 model_provider 元数据，不改消息正文。不同后端对旧会话状态的兼容性仍由对应服务决定。' 'A full backup is created first. Migration only rewrites model_provider metadata, not message bodies. Compatibility of old session state still depends on the target backend.')"
    printf '\n'

    # Guarded repair first: stop Codex, back up all history, recover missing
    # SQLite/index records, then migrate every recovered thread to the active
    # provider. The current config.toml/auth.json are not switched here.
    if cmd_repair_history_auto restore-all; then
        rc=0
    else
        rc=$?
    fi
    if [[ "$rc" -eq 2 ]]; then
        return 0
    fi
    [[ "$rc" -eq 0 ]] || return "$rc"

    printf '\n'
    if ! cmd_migrate_history_to_current_provider; then
        ui_fail "$(L 'Provider 迁移失败；已停止后续流程。修复前的完整备份仍保留。' 'Provider migration failed; the workflow has stopped. The pre-repair full backup is preserved.')"
        return 1
    fi

    printf '\n'
    if ! cmd_health; then
        ui_fail "$(L '迁移后的健康检查失败；不会自动打开聊天。' 'Post-migration health check failed; chats will not be opened automatically.')"
        return 1
    fi

    printf '\n'
    ui_ok "$(L "全部历史已恢复到当前中转站 $profile，正在用当前模型打开聊天列表…" "All history is now attached to the active route $profile. Opening the chat list with the active model…")"
    sleep 0.4

    # Keep the public resume-all/all-history behavior unchanged. restore-all is
    # the one path that explicitly asks Codex to continue migrated threads with
    # the active profile settings instead of restoring an old thread model.
    write_config_for_profile "$profile"
    load_profile "$profile"
    cmd_run resume -m "$P_MODEL" --all --include-non-interactive
}


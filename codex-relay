case "${1:-}" in
    menu)
        shift; cmd_menu "$@" ;;
    list)
        shift; cmd_list "$@" ;;
    status)
        shift; cmd_status "$@" ;;
    quota|usage)
        shift; cmd_quota "$@" ;;
    use)
        shift; cmd_use "$@" ;;
    switch)
        shift; cmd_switch "$@" ;;
    key|keys)
        shift; cmd_key "$@" ;;
    official)
        shift; cmd_official "$@" ;;
    add)
        shift; cmd_add "$@" ;;
    providers|provider)
        shift; cmd_providers "$@" ;;
    model)
        shift; cmd_model "$@" ;;
    endpoint|url)
        shift; cmd_endpoint "$@" ;;
    speed|ping)
        shift; cmd_speed "$@" ;;
    delete|remove)
        shift; cmd_delete_profile "$@" ;;
    show-config)
        shift; cmd_show_config "$@" ;;
    check)
        shift; cmd_check "$@" ;;
    direct)
        shift; cmd_direct "$@" ;;
    setup)
        shift; cmd_setup "$@" ;;
    services|service|ps)
        shift; cmd_services "$@" ;;
    stop|stop-all|shutdown)
        shift; cmd_stop "$@" ;;
    run)
        shift; cmd_run "$@" ;;
    history)
        shift; cmd_history "$@" ;;
    search|history-search)
        shift; cmd_search "$@" ;;
    recover-menu)
        shift; cmd_recover_menu "$@" ;;
    resume|recover)
        shift; cmd_resume "$@" ;;
    resume-all)
        shift; cmd_resume_all "$@" ;;
    health|history-check)
        shift; cmd_health "$@" ;;
    backup|history-backup)
        shift; cmd_backup "$@" ;;
    reindex|history-reindex)
        shift; cmd_reindex "$@" ;;
    repair-history|repair)
        shift; cmd_repair_history "$@" ;;
    language|lang)
        shift; cmd_language "$@" ;;
    "")
        cmd_providers ;;
    help|-h|--help)
        usage ;;
    *)
        if [[ "$RELAY_LANG" == "en" ]]; then
            die "Unknown command: $1 (run cr help)"
        else
            die "未知命令: $1（运行 cr help 查看帮助）"
        fi
        ;;
esac

        ui_menu_item "0" "$(L '返回' 'Back')" ""
        printf '\n> '; read -r choice
        case "$choice" in
            1) clear || true; cmd_quota --refresh || true; ui_pause ;;
            2) cmd_key_menu ;;
            3) clear || true; cmd_list; ui_pause ;;
            4) clear || true; ui_header "CONFIG.TOML"; cmd_show_config; ui_pause ;;
            5) cmd_language_menu ;;
            6) clear || true; cmd_status; ui_pause ;;
            0|q|Q) return ;;
            *) ui_warn "$(L '无效选择' 'Invalid choice')"; sleep 0.5 ;;
        esac
    done
}

# -----------------------------
# 菜单
# -----------------------------
cmd_menu() {
    local choice name key_state network quota cli daemon daemon_text processes proxy_text host
    while true; do
        name="$(current_profile)"
        load_profile "$name"

        if [[ "$P_AUTH" == "relay" ]]; then
            if relay_key_exists "$name"; then
                key_state="$(L '✓ 已设置' '✓ SET')"
            else
                key_state="$(L '✕ 未设置' '✕ NOT SET')"
            fi
        else
            key_state="$(L 'Codex 官方认证' 'Codex native auth')"
        fi

        network="$(dashboard_network_summary "$name")"
        quota="$(official_quota_summary)"
        cli="$(dashboard_cli_version)"
        daemon="$(dashboard_daemon_version)"
        daemon_text="$daemon"
        if [[ "$cli" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ && "$daemon" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ && "$cli" != "$daemon" ]]; then
            daemon_text="$daemon ⚠ $(L '版本不一致' 'VERSION MISMATCH')"
        fi
        processes="$(codex_process_count)"
        host="$(url_host "$P_URL" 2>/dev/null || printf '%s' "$P_URL")"

        if env | grep -qiE '^(http|https|all)_proxy='; then
            proxy_text="$(L 'DETECTED → 启动时禁用' 'DETECTED → disabled on launch')"
        else
            proxy_text="CLEAN"
        fi

        clear || true
        ui_header "$(L '控制中心' 'CONTROL CENTER')"

        ui_section "$(L '当前状态' 'STATUS')"
        ui_kv "$(L '中转站' 'provider')" "● $name"
        ui_kv "model" "$P_MODEL${P_REASONING:+ · $P_REASONING}"
        ui_kv "endpoint" "$host"
        ui_kv "API Key" "$key_state"
        ui_kv "$(L '网络' 'network')" "$network"
        ui_kv "Codex CLI" "$cli"
        ui_kv "daemon" "$daemon_text"
        ui_kv "$(L 'Codex 进程' 'processes')" "$processes"
        ui_kv "$(L 'Shell 代理' 'shell proxy')" "$proxy_text"
        ui_kv "$(L '官方额度' 'official quota')" "$quota"
        if [[ "$P_AUTH" == "relay" ]]; then
            ui_kv "$(L '中转额度' 'relay quota')" "$(L 'N/A · 服务商未提供稳定公开接口' 'N/A · no stable public provider API')"
        fi

        ui_section "$(L '功能' 'MAIN')"
        ui_menu_item "1" "$(L '中转站' 'Providers')" "$(L '切换 · 模型 · 地址 · Key · 测速' 'switch · model · endpoint · key · speed')"
        ui_menu_item "2" "$(L '聊天历史' 'Chat / History')" "$(L '最近 · 搜索 · 恢复 · 修复' 'recent · search · resume · repair')"
        ui_menu_item "3" "$(L '网络与服务' 'Network & Services')" "$(L '诊断 · Direct · daemon · 一键停止' 'diagnostics · direct · daemon · stop')"
        ui_menu_item "4" "$(L '设置' 'Settings')" "$(L '额度 · Key · 配置 · 语言' 'quota · key · config · language')"
        printf '\n'
        ui_menu_item "Enter" "$(L '启动当前 Codex' 'Launch current Codex')" "$name"
        ui_menu_item "R" "$(L '刷新状态' 'Refresh status')" "$(L '网络 + 额度' 'network + quota')"
        ui_menu_item "Q" "$(L '退出' 'Exit')" ""

        printf '\n%s›%s %s%s%s  ' "$UI_PINK" "$UI_RESET" "$UI_BOLD" "$(L '请选择操作' 'Choose an action')" "$UI_RESET"
        read -r choice
        case "$choice" in
            "")
                cmd_run
                ;;
            1)
                cmd_providers
                ;;
            2)
                cmd_menu_history
                ;;
            3)
                cmd_menu_network
                ;;
            4)
                cmd_menu_settings
                ;;
            r|R)
                dashboard_refresh
                ;;
            q|Q|0)
                printf '\n%s%s%s\n' "$UI_DIM" "$(L '已退出。' 'Goodbye.')" "$UI_RESET"
                return
                ;;
            *)
                ui_warn "$(L "无效选择: $choice" "Invalid choice: $choice")"
                sleep 0.5
                ;;
        esac
    done
}


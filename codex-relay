SELECT
    substr(id,1,18) AS id,
    datetime(updated_at,'unixepoch','localtime') AS updated,
    model_provider AS provider,
    COALESCE(model,'') AS model,
    substr(
        COALESCE(
            NULLIF(name,''),
            NULLIF(title,''),

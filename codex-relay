profile_for_old_provider() {
    local provider="$1" current
    current="$(current_profile)"

    if profile_exists "$current"; then
        load_profile "$current"
        if [[ "$P_PROVIDER" == "$provider" ]]; then
            echo "$current"
            return
        fi
    fi

    case "$provider" in

dashboard_cli_version() {
    command -v codex >/dev/null 2>&1 || { printf '%s' "N/A"; return; }
    codex --version 2>/dev/null | grep -Eo '[0-9]+\.[0-9]+\.[0-9]+' | head -n1 || printf '%s' "?"
}

dashboard_daemon_version() {
    command -v codex >/dev/null 2>&1 || { printf '%s' "N/A"; return; }
    local out
    out="$(codex app-server daemon version 2>/dev/null || true)"
    if [[ -z "$out" ]]; then
        printf '%s' "$(L '未运行/未知' 'stopped/unknown')"
        return
    fi
    printf '%s\n' "$out" | grep -Eo '[0-9]+\.[0-9]+\.[0-9]+' | head -n1 || printf '%s' "?"
}

dashboard_network_summary() {
    local name="$1" file result code sec ms
    file="$CACHE_DIR/network-$name.txt"
    if cache_fresh "$file" 20; then
        cat "$file"
        return
    fi

    load_profile "$name"
    result="$(env -u http_proxy -u https_proxy -u HTTP_PROXY -u HTTPS_PROXY -u all_proxy -u ALL_PROXY \
        curl --noproxy '*' -4 -sS -o /dev/null -w '%{http_code} %{time_total}' \
        --connect-timeout 2 --max-time 3 "$P_URL" 2>/dev/null)" || true

    code="${result%% *}"
    sec="${result#* }"
    if [[ -n "$result" && "$code" != "000" ]]; then
        ms="$(awk -v t="$sec" 'BEGIN{printf "%.0f",t*1000}')"
        printf '✓ Direct · %s ms\n' "$ms" > "$file"
    else
        printf '✕ Unreachable\n' > "$file"
    fi
    cat "$file"
}


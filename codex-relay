find_thread_info() {
    local target="$1"

    python3 - "$CODEX_DIR" "$target" <<'PY'
from pathlib import Path
import sqlite3,json,sys

home=Path(sys.argv[1])
target=sys.argv[2]
found=[]

db=home/"state_5.sqlite"
if db.exists():
    c=sqlite3.connect(db)
    found=c.execute("""
        SELECT id,model_provider,COALESCE(model,''),
               COALESCE(NULLIF(name,''),NULLIF(title,''),NULLIF(first_user_message,''),'(untitled)')
        FROM threads
        WHERE id=? OR id LIKE ?
        ORDER BY updated_at DESC
    """,(target,target+"%")).fetchall()
    c.close()

if len(found)==1:
    row=found[0]
    print("\t".join(str(x).replace("\t"," ").replace("\n"," ") for x in row))
    raise SystemExit(0)
if len(found)>1:
    print("匹配多个 thread，请使用更完整 ID:",file=sys.stderr)
    for r in found[:20]:
        print(r[0],r[1],r[3][:80],file=sys.stderr)
    raise SystemExit(2)

rollouts={}
for dirname in ("sessions", "archived_sessions"):
    root=home/dirname
    if not root.exists():
        continue
    for path in root.rglob("rollout-*.jsonl"):
        try:
            with path.open("r",encoding="utf-8",errors="replace") as f:
                for line in f:
                    try:
                        obj=json.loads(line)
                    except Exception:
                        continue
                    if obj.get("type") != "session_meta":
                        continue
                    p=obj.get("payload",{})
                    sid=p.get("id","")
                    if sid == target or sid.startswith(target):
                        rollouts[sid]=(p.get("model_provider",""),p.get("model",""),"(from rollout)")
                    break
        except Exception:
            pass

if len(rollouts)==1:
    sid=next(iter(rollouts))
    p,m,t=rollouts[sid]
    print(f"{sid}\t{p}\t{m}\t{t}")
    raise SystemExit(0)
if len(rollouts)>1:
    print("rollout 中匹配多个 ID，请使用更完整 ID:",file=sys.stderr)
    for sid in rollouts:
        print(sid,file=sys.stderr)
    raise SystemExit(2)

print("没有找到该 thread",file=sys.stderr)
raise SystemExit(1)
PY
}

profile_for_old_provider() {
    local provider="$1"
    case "$provider" in
        baibai) echo "baibai" ;;
        OpenAI) echo "nova" ;;
        openai) echo "official" ;;
        *)
            local hit
            hit="$(awk -F '\t' -v p="$provider" '$2==p {print $1; exit}' "$REGISTRY")"
            [[ -n "$hit" ]] && echo "$hit" || echo "$(current_profile)"
            ;;    esac
}

cmd_resume() {
    [[ $# -ge 1 && $# -le 2 ]] || die "用法: cr resume THREAD_ID [PROFILE]"

    local target="$1" forced="${2:-}" info tid old_provider old_model title profile
    info="$(find_thread_info "$target")" || exit $?
    IFS=$'\t' read -r tid old_provider old_model title <<< "$info"

    if [[ -n "$forced" ]]; then
        profile="$forced"
    else
        profile="$(profile_for_old_provider "$old_provider")"
    fi

    if [[ "$profile" == "official" && ! -s "$OFFICIAL_MODEL_FILE" ]]; then
        die "该聊天属于官方 openai，但 official 尚未设置模型。先运行: cr official MODEL"
    fi

    echo "恢复聊天:"
    echo "  ID          : $tid"
    echo "  old provider: $old_provider"
    echo "  old model   : $old_model"
    echo "  title       : $title"
    echo "  use profile : $profile"

    write_config_for_profile "$profile"
    cmd_run resume "$tid"
}

cmd_resume_all() {
    local profile="${1:-$(current_profile)}"
    write_config_for_profile "$profile"
    cmd_run resume --all --include-non-interactive
}

